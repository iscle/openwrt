 }
 
+static void airoha_ppe_free_flow(void *ptr, void *arg)
+{
+	struct airoha_flow_table_entry *e = ptr;
+	struct airoha_ppe *ppe = arg;
+
+	airoha_ppe_foe_flow_remove_entry(ppe, e);
+	dev_put(e->wdma_dev);
+	kfree(e);
+}
+
 void airoha_ppe_deinit(struct airoha_eth *eth)
 {
 	struct airoha_npu *npu;
 
 	if (!eth->ppe)
 		return;
+
+	if (eth->ppe->netdevice_registered)
+		unregister_netdevice_notifier(&eth->ppe->netdevice_nb);
 
 	mutex_lock(&flow_offload_mutex);
 
@@ -1768,7 +1990,8 @@
 
 	mutex_unlock(&flow_offload_mutex);
 
+	rhashtable_free_and_destroy(&eth->flow_table, airoha_ppe_free_flow,
+				    eth->ppe);
 	rhashtable_destroy(&eth->ppe->l2_flows);
-	rhashtable_destroy(&eth->flow_table);
 	debugfs_remove(eth->ppe->debugfs_dir);
 }
