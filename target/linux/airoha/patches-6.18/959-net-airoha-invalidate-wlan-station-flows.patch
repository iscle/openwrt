Subject: [PATCH] net: airoha: invalidate WLAN paths before station ID reuse

Track WLAN flow owners, invalidate their bound hardware paths before WCID
reuse, and refresh radio forwarding identities when a flow is rebound.

---
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -514,6 +514,14 @@
 		};
 	};
 
+	/* Protected by ppe_lock, including the cached WDMA identity. */
+	struct hlist_node wlan_node;
+	struct net_device *wdma_dev;
+	bool wdma_dead;
+	u8 wdma_addr[ETH_ALEN];
+	u8 wdma_idx;
+	u16 wdma_wcid;
+
 	struct hlist_node l2_subflow_node; /* PPE L2 subflow entry */
 	u32 hash;
 
@@ -617,6 +625,9 @@
 
 	struct rhashtable l2_flows;
 
+	struct hlist_head wlan_flows;
+	struct notifier_block netdevice_nb;
+	bool netdevice_registered;
 	struct hlist_head *foe_flow;
 	u16 *foe_check_time;
 
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -317,6 +317,48 @@
 	info->idx = path->mtk_wdma.wdma_idx;
 	info->bss = path->mtk_wdma.bss;
 	info->wcid = path->mtk_wdma.wcid;
+
+	return 0;
+}
+
+/* Rebinding must not reuse a station identity cached before a reconnect. */
+static int
+airoha_ppe_foe_refresh_wdma(struct airoha_flow_table_entry *e)
+{
+	struct airoha_foe_mac_info_common *l2;
+	struct airoha_wdma_info info = {};
+	u32 *ib2, *data;
+	int type, err;
+
+	if (e->wdma_dead)
+		return -ENODEV;
+	if (!e->wdma_dev)
+		return 0;
+
+	lockdep_assert_held(&ppe_lock);
+	err = airoha_ppe_get_wdma_info(e->wdma_dev, e->wdma_addr, &info);
+	if (err)
+		return err;
+
+	type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, e->data.ib1);
+	if (type >= PPE_PKT_TYPE_IPV6_ROUTE_3T) {
+		l2 = &e->data.ipv6.l2;
+		ib2 = &e->data.ipv6.ib2;
+		data = &e->data.ipv6.data;
+	} else {
+		l2 = &e->data.bridge.l2.common;
+		ib2 = &e->data.bridge.ib2;
+		data = &e->data.bridge.data;
+	}
+	l2->etype &= ~(AIROHA_FOE_MAC_WDMA_BAND | AIROHA_FOE_MAC_WDMA_WCID);
+	l2->etype |= FIELD_PREP(AIROHA_FOE_MAC_WDMA_BAND, info.idx) |
+		     FIELD_PREP(AIROHA_FOE_MAC_WDMA_WCID, info.wcid);
+	*ib2 = (*ib2 & ~AIROHA_FOE_IB2_NBQ) |
+		FIELD_PREP(AIROHA_FOE_IB2_NBQ, info.idx);
+	*data = (*data & ~AIROHA_FOE_ACTDP) |
+		FIELD_PREP(AIROHA_FOE_ACTDP, info.bss);
+	e->wdma_idx = info.idx;
+	e->wdma_wcid = info.wcid;
 
 	return 0;
 }
@@ -857,6 +899,7 @@
 {
 	spin_lock_bh(&ppe_lock);
 
+	hlist_del_init(&e->wlan_node);
 	if (e->type == FLOW_TYPE_L2)
 		airoha_ppe_foe_remove_l2_flow(ppe, e);
 	else
@@ -878,6 +921,9 @@
 	hwe_p = airoha_ppe_foe_get_entry_locked(ppe, hash);
 	if (!hwe_p)
 		return -EINVAL;
+
+	if (airoha_ppe_foe_refresh_wdma(e))
+		return -ENODEV;
 
 	/* Native L2 entries cannot insert or remove PPPoE headers. */
 	if (airoha_is_7563(ppe->eth) &&
@@ -976,6 +1022,8 @@
 		if (!airoha_ppe_foe_compare_entry(e, hwe))
 			continue;
 
+		if (airoha_ppe_foe_refresh_wdma(e))
+			continue;
 		airoha_ppe_foe_commit_entry(ppe, &e->data, hash, rx_wlan);
 		commit_done = true;
 		e->hash = hash;
@@ -1019,19 +1067,157 @@
 {
 	int type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, e->data.ib1);
 	u32 hash;
-
-	if (type == PPE_PKT_TYPE_BRIDGE)
-		return airoha_ppe_foe_l2_flow_commit_entry(ppe, e);
-
-	hash = airoha_ppe_foe_get_entry_hash(ppe, &e->data);
-	e->type = FLOW_TYPE_L4;
+	int ret = 0;
+
 	e->hash = 0xffff;
-
 	spin_lock_bh(&ppe_lock);
-	hlist_add_head(&e->list, &ppe->foe_flow[hash]);
+	if (e->wdma_dev &&
+	    READ_ONCE(e->wdma_dev->reg_state) != NETREG_REGISTERED) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+	if (type == PPE_PKT_TYPE_BRIDGE) {
+		ret = airoha_ppe_foe_l2_flow_commit_entry(ppe, e);
+	} else {
+		hash = airoha_ppe_foe_get_entry_hash(ppe, &e->data);
+		e->type = FLOW_TYPE_L4;
+		hlist_add_head(&e->list, &ppe->foe_flow[hash]);
+	}
+	if (!ret && e->wdma_dev)
+		hlist_add_head(&e->wlan_node, &ppe->wlan_flows);
+unlock:
 	spin_unlock_bh(&ppe_lock);
 
+	return ret;
+}
+
+static int airoha_ppe_foe_invalidate_wdma(struct airoha_ppe *ppe, u32 hash,
+					  u16 wcid, u8 band)
+{
+	struct airoha_foe_entry *entry, hwe;
+	u32 type, ib2;
+	u16 etype;
+
+	if (hash == 0xffff)
+		return 0;
+	entry = airoha_ppe_foe_get_entry_locked(ppe, hash);
+	if (!entry)
+		return -EIO;
+	hwe = *entry;
+	if (FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe.ib1) != AIROHA_FOE_STATE_BIND)
+		return 0;
+	type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe.ib1);
+	if (airoha_is_7563(ppe->eth) && type == PPE_PKT_TYPE_BRIDGE) {
+		ib2 = hwe.bridge_an7563.ib2;
+		etype = hwe.bridge_an7563.etype;
+	} else if (type >= PPE_PKT_TYPE_IPV6_ROUTE_3T) {
+		ib2 = hwe.ipv6.ib2;
+		etype = hwe.ipv6.l2.etype;
+	} else {
+		ib2 = hwe.bridge.ib2;
+		etype = hwe.bridge.l2.common.etype;
+	}
+	if (FIELD_GET(AIROHA_FOE_IB2_PSE_PORT, ib2) != FE_PSE_PORT_CDM4 ||
+	    FIELD_GET(AIROHA_FOE_MAC_WDMA_WCID, etype) != wcid ||
+	    FIELD_GET(AIROHA_FOE_MAC_WDMA_BAND, etype) != band)
+		return 0;
+
+	hwe.ib1 &= ~AIROHA_FOE_IB1_BIND_STATE;
+	return airoha_ppe_foe_commit_entry(ppe, &hwe, hash, false);
+}
+
+static int
+airoha_ppe_flush_wdma_entry(struct airoha_ppe *ppe,
+			    struct airoha_flow_table_entry *e)
+{
+	struct airoha_flow_table_entry *sub;
+	struct hlist_node *next;
+	int err;
+
+	lockdep_assert_held(&ppe_lock);
+	if (e->type != FLOW_TYPE_L2) {
+		err = airoha_ppe_foe_invalidate_wdma(ppe, e->hash,
+						     e->wdma_wcid, e->wdma_idx);
+		if (!err)
+			e->hash = 0xffff;
+		return err;
+	}
+
+	hlist_for_each_entry_safe(sub, next, &e->l2_flows, l2_subflow_node) {
+		err = airoha_ppe_foe_invalidate_wdma(ppe, sub->hash,
+						     e->wdma_wcid, e->wdma_idx);
+		if (err)
+			return err;
+		sub->hash = 0xffff;
+		airoha_ppe_foe_remove_flow(ppe, sub);
+	}
+
 	return 0;
+}
+
+static void airoha_ppe_flush_wdma_failed(struct airoha_ppe *ppe, int err)
+{
+	int i;
+
+	/* A failed table write must not leave a reusable radio ID bound. */
+	for (i = 0; i < ppe->eth->soc->num_ppe; i++)
+		airoha_fe_clear(ppe->eth, REG_PPE_GLO_CFG(i),
+				PPE_GLO_CFG_EN_MASK);
+	dev_err(ppe->eth->dev, "PPE disabled after station flush failure: %d\n",
+		err);
+}
+
+/* Called after radio authorization is revoked, before its WCID is reused. */
+static int airoha_ppe_flush_wdma(struct airoha_ppe_dev *dev, u16 wcid, u8 band)
+{
+	struct airoha_ppe *ppe = dev->priv;
+	struct airoha_flow_table_entry *e;
+	int err = 0;
+
+	spin_lock_bh(&ppe_lock);
+	hlist_for_each_entry(e, &ppe->wlan_flows, wlan_node) {
+		if (e->wdma_wcid != wcid || e->wdma_idx != band)
+			continue;
+		err = airoha_ppe_flush_wdma_entry(ppe, e);
+		if (err)
+			break;
+	}
+	if (err)
+		airoha_ppe_flush_wdma_failed(ppe, err);
+	spin_unlock_bh(&ppe_lock);
+
+	return err;
+}
+
+static int airoha_ppe_netdevice_event(struct notifier_block *nb,
+				      unsigned long event, void *ptr)
+{
+	struct net_device *netdev = netdev_notifier_info_to_dev(ptr);
+	struct airoha_ppe *ppe = container_of(nb, struct airoha_ppe,
+					     netdevice_nb);
+	struct airoha_flow_table_entry *e;
+	int err;
+
+	if (event != NETDEV_UNREGISTER)
+		return NOTIFY_DONE;
+
+	spin_lock_bh(&ppe_lock);
+	hlist_for_each_entry(e, &ppe->wlan_flows, wlan_node) {
+		if (e->wdma_dev != netdev)
+			continue;
+		err = airoha_ppe_flush_wdma_entry(ppe, e);
+		if (err)
+			airoha_ppe_flush_wdma_failed(ppe, err);
+		/* TC rules may outlive their redirect device. Keep their owner
+		 * until TC deletes it, but never rebind its old radio identity.
+		 */
+		e->wdma_dead = true;
+		e->wdma_dev = NULL;
+		dev_put(netdev);
+	}
+	spin_unlock_bh(&ppe_lock);
+
+	return NOTIFY_DONE;
 }
 
 static int airoha_ppe_get_entry_idle_time(struct airoha_ppe *ppe, u32 ib1)
