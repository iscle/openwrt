--- /dev/null
+++ b/Documentation/devicetree/bindings/pci/airoha,an7563-pcie.yaml
@@ -0,0 +1,58 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/pci/airoha,an7563-pcie.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Airoha AN7563 PCIe host controller
+
+maintainers:
+  - Iscle <albertiscle9@gmail.com>
+
+allOf:
+  - $ref: /schemas/pci/pci-host-bridge.yaml#
+
+properties:
+  compatible:
+    const: airoha,an7563-pcie
+  reg:
+    maxItems: 1
+  reg-names:
+    enum: [port0, port1]
+  clocks:
+    maxItems: 1
+  clock-names:
+    enum: [sys_ck0, sys_ck1]
+  interrupts:
+    maxItems: 1
+  interrupt-names:
+    const: pcie_irq
+  ranges:
+    maxItems: 1
+  '#interrupt-cells':
+    const: 1
+  interrupt-controller:
+    type: object
+    properties:
+      interrupt-controller: true
+      '#address-cells':
+        const: 0
+      '#interrupt-cells':
+        const: 1
+    required:
+      - interrupt-controller
+      - '#interrupt-cells'
+    additionalProperties: false
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - clocks
+  - clock-names
+  - interrupts
+  - interrupt-names
+  - ranges
+  - interrupt-controller
+
+unevaluatedProperties: false
--- /dev/null
+++ b/Documentation/devicetree/bindings/pinctrl/airoha,an7563-pinctrl.yaml
@@ -0,0 +1,79 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/pinctrl/airoha,an7563-pinctrl.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Airoha AN7563 pin controller
+
+maintainers:
+  - Iscle <albertiscle9@gmail.com>
+
+allOf:
+  - $ref: pinctrl.yaml#
+
+properties:
+  compatible:
+    const: airoha,an7563-pinctrl
+  interrupts:
+    maxItems: 1
+  gpio-controller: true
+  '#gpio-cells':
+    const: 2
+  gpio-ranges:
+    maxItems: 1
+  interrupt-controller: true
+  '#interrupt-cells':
+    const: 2
+
+patternProperties:
+  '-hog$':
+    type: object
+    $ref: /schemas/gpio/gpio-hog.yaml#
+  '-pins$':
+    type: object
+    additionalProperties: false
+    patternProperties:
+      '^mux(-|$)':
+        type: object
+        $ref: pinmux-node.yaml#
+        additionalProperties: false
+        properties:
+          function:
+            enum: [pon, tod_1pps, sipo, mdio, uart, i2c, jtag, pcm, spi,
+                   pcm_spi, i2s, emmc, pnand, pcie_reset, pwm, phy1_led0,
+                   phy2_led0, phy3_led0, phy4_led0, phy1_led1, phy2_led1,
+                   phy3_led1, phy4_led1]
+          groups:
+            $ref: /schemas/types.yaml#/definitions/string-array
+        required: [function, groups]
+      '^conf(-|$)':
+        type: object
+        $ref: pincfg-node.yaml#
+        unevaluatedProperties: false
+        properties:
+          pins:
+            $ref: /schemas/types.yaml#/definitions/string-array
+            items:
+              pattern: '^gpio([0-9]|[1-3][0-9]|4[0-6])$'
+          bias-disable: true
+          bias-pull-up: true
+          bias-pull-down: true
+          drive-strength: true
+          input-enable: true
+          input-disable: true
+          output-enable: true
+          output-disable: true
+          output-high: true
+          output-low: true
+        required: [pins]
+
+required:
+  - compatible
+  - interrupts
+  - gpio-controller
+  - '#gpio-cells'
+  - interrupt-controller
+  - '#interrupt-cells'
+
+additionalProperties: false
