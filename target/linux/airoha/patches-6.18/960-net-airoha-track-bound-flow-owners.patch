Subject: [PATCH] net: airoha: track the owner of each bound PPE slot

Hardware ages and reuses slots independently of TC rule lifetimes. Track
the owner when binding a slot, detach the previous owner before reuse,
and only invalidate a slot still owned by the rule being removed. Release
aged L2 children on reuse instead of accumulating stale slot references.

Publish new owners only after a successful write. Disable forwarding on
write failure because a timed out transaction may have reached hardware.
Reject a second MAC-only L2 owner rather than silently replacing the
first rule while its hardware subflows and TC cookie remain alive.

---
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -629,6 +629,7 @@
 	struct notifier_block netdevice_nb;
 	bool netdevice_registered;
 	struct hlist_head *foe_flow;
+	struct airoha_flow_table_entry **foe_owner;
 	u16 *foe_check_time;
 
 	struct airoha_foe_stats *foe_stats;
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -792,7 +792,8 @@
 	int type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, e->data.ib1);
 	int len;
 
-	if ((hwe->ib1 ^ e->data.ib1) & AIROHA_FOE_IB1_BIND_UDP)
+	if ((hwe->ib1 ^ e->data.ib1) & (AIROHA_FOE_IB1_BIND_UDP |
+				      AIROHA_FOE_IB1_BIND_PACKET_TYPE))
 		return false;
 
 	if (type > PPE_PKT_TYPE_IPV4_DSLITE)
@@ -861,23 +862,72 @@
 	return err;
 }
 
+static void airoha_ppe_foe_write_failed(struct airoha_ppe *ppe, int err)
+{
+	int i;
+
+	/* A timed out write may have reached hardware. Stop forwarding before
+	 * releasing its software owner or any referenced destination.
+	 */
+	for (i = 0; i < ppe->eth->soc->num_ppe; i++)
+		airoha_fe_clear(ppe->eth, REG_PPE_GLO_CFG(i),
+				PPE_GLO_CFG_EN_MASK);
+	dev_err(ppe->eth->dev, "PPE disabled after flow write failure: %d\n",
+		err);
+}
+
+static void airoha_ppe_foe_unbind_flow(struct airoha_ppe *ppe,
+				       struct airoha_flow_table_entry *e)
+{
+	struct airoha_foe_entry *entry, hwe;
+	int err = 0;
+	u32 hash = e->hash;
+
+	lockdep_assert_held(&ppe_lock);
+	if (hash == 0xffff)
+		return;
+	if (ppe->foe_owner[hash] != e)
+		goto clear_hash;
+
+	entry = airoha_ppe_foe_get_entry_locked(ppe, hash);
+	if (!entry) {
+		err = -EIO;
+	} else if (FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, entry->ib1) ==
+		   AIROHA_FOE_STATE_BIND) {
+		hwe = *entry;
+		hwe.ib1 &= ~AIROHA_FOE_IB1_BIND_STATE;
+		err = airoha_ppe_foe_commit_entry(ppe, &hwe, hash, false);
+	}
+	if (err)
+		airoha_ppe_foe_write_failed(ppe, err);
+	ppe->foe_owner[hash] = NULL;
+clear_hash:
+	e->hash = 0xffff;
+}
+
 static void airoha_ppe_foe_remove_flow(struct airoha_ppe *ppe,
 				       struct airoha_flow_table_entry *e)
 {
 	lockdep_assert_held(&ppe_lock);
 
 	hlist_del_init(&e->list);
-	if (e->hash != 0xffff) {
-		e->data.ib1 &= ~AIROHA_FOE_IB1_BIND_STATE;
-		e->data.ib1 |= FIELD_PREP(AIROHA_FOE_IB1_BIND_STATE,
-					  AIROHA_FOE_STATE_INVALID);
-		airoha_ppe_foe_commit_entry(ppe, &e->data, e->hash, false);
-		e->hash = 0xffff;
-	}
+	airoha_ppe_foe_unbind_flow(ppe, e);
 	if (e->type == FLOW_TYPE_L2_SUBFLOW) {
 		hlist_del_init(&e->l2_subflow_node);
 		kfree(e);
 	}
+}
+
+static void airoha_ppe_foe_release_slot(struct airoha_ppe *ppe, u32 hash)
+{
+	struct airoha_flow_table_entry *e = ppe->foe_owner[hash];
+
+	lockdep_assert_held(&ppe_lock);
+	if (!e)
+		return;
+	airoha_ppe_foe_unbind_flow(ppe, e);
+	if (e->type == FLOW_TYPE_L2_SUBFLOW)
+		airoha_ppe_foe_remove_flow(ppe, e);
 }
 
 static void airoha_ppe_foe_remove_l2_flow(struct airoha_ppe *ppe,
@@ -916,7 +966,7 @@
 	u32 mask = AIROHA_FOE_IB1_BIND_PACKET_TYPE | AIROHA_FOE_IB1_BIND_UDP;
 	struct airoha_foe_entry *hwe_p, hwe;
 	struct airoha_flow_table_entry *f;
-	int type;
+	int type, err;
 
 	hwe_p = airoha_ppe_foe_get_entry_locked(ppe, hash);
 	if (!hwe_p)
@@ -935,9 +985,6 @@
 	if (!f)
 		return -ENOMEM;
 
-	hlist_add_head(&f->l2_subflow_node, &e->l2_flows);
-	f->type = FLOW_TYPE_L2_SUBFLOW;
-	f->hash = hash;
 
 	memcpy(&hwe, hwe_p, sizeof(*hwe_p));
 	hwe.ib1 = (hwe.ib1 & mask) | (e->data.ib1 & ~mask);
@@ -977,7 +1024,18 @@
 
 	hwe.bridge.data = e->data.bridge.data;
 commit:
-	airoha_ppe_foe_commit_entry(ppe, &hwe, hash, rx_wlan);
+	airoha_ppe_foe_release_slot(ppe, hash);
+	err = airoha_ppe_foe_commit_entry(ppe, &hwe, hash, rx_wlan);
+	if (err) {
+		airoha_ppe_foe_write_failed(ppe, err);
+		kfree(f);
+		return err;
+	}
+	f->data = hwe;
+	f->type = FLOW_TYPE_L2_SUBFLOW;
+	f->hash = hash;
+	ppe->foe_owner[hash] = f;
+	hlist_add_head(&f->l2_subflow_node, &e->l2_flows);
 
 	return 0;
 }
@@ -1013,7 +1071,6 @@
 		if (e->type == FLOW_TYPE_L2_SUBFLOW) {
 			state = FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe->ib1);
 			if (state != AIROHA_FOE_STATE_BIND) {
-				e->hash = 0xffff;
 				airoha_ppe_foe_remove_flow(ppe, e);
 			}
 			continue;
@@ -1024,9 +1081,16 @@
 
 		if (airoha_ppe_foe_refresh_wdma(e))
 			continue;
-		airoha_ppe_foe_commit_entry(ppe, &e->data, hash, rx_wlan);
+		airoha_ppe_foe_unbind_flow(ppe, e);
+		airoha_ppe_foe_release_slot(ppe, hash);
+		if (airoha_ppe_foe_commit_entry(ppe, &e->data, hash, rx_wlan)) {
+			airoha_ppe_foe_write_failed(ppe, -EIO);
+			goto unlock;
+		}
 		commit_done = true;
 		e->hash = hash;
+		ppe->foe_owner[hash] = e;
+		break;
 	}
 
 	if (commit_done)
@@ -1057,9 +1121,10 @@
 	if (IS_ERR(prev))
 		return PTR_ERR(prev);
 
-	return rhashtable_replace_fast(&ppe->l2_flows, &prev->l2_node,
-				       &e->l2_node,
-				       airoha_l2_flow_table_params);
+	/* Both TC cookies must retain their own lifetime. A MAC-only table
+	 * cannot represent a second owner with different forwarding actions.
+	 */
+	return -EEXIST;
 }
 
 static int airoha_ppe_foe_flow_commit_entry(struct airoha_ppe *ppe,
@@ -1139,7 +1204,7 @@
 		err = airoha_ppe_foe_invalidate_wdma(ppe, e->hash,
 						     e->wdma_wcid, e->wdma_idx);
 		if (!err)
-			e->hash = 0xffff;
+			airoha_ppe_foe_unbind_flow(ppe, e);
 		return err;
 	}
 
@@ -1148,7 +1213,6 @@
 						     e->wdma_wcid, e->wdma_idx);
 		if (err)
 			return err;
-		sub->hash = 0xffff;
 		airoha_ppe_foe_remove_flow(ppe, sub);
 	}
 
@@ -1261,7 +1325,6 @@
 		ib1 = READ_ONCE(hwe->ib1);
 		state = FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, ib1);
 		if (state != AIROHA_FOE_STATE_BIND) {
-			iter->hash = 0xffff;
 			airoha_ppe_foe_remove_flow(ppe, iter);
 			continue;
 		}
@@ -1297,6 +1360,8 @@
 
 	memcpy(&hwe, hwe_p, sizeof(*hwe_p));
 	if (!airoha_ppe_foe_compare_entry(e, &hwe)) {
+		if (ppe->foe_owner[e->hash] == e)
+			ppe->foe_owner[e->hash] = NULL;
 		e->hash = 0xffff;
 		goto unlock;
 	}
@@ -1900,6 +1965,11 @@
 	if (!ppe->foe_flow)
 		return -ENOMEM;
 
+	ppe->foe_owner = devm_kcalloc(eth->dev, ppe_num_entries,
+				      sizeof(*ppe->foe_owner), GFP_KERNEL);
+	if (!ppe->foe_owner)
+		return -ENOMEM;
+
 	ppe_num_stats_entries = airoha_ppe_get_total_num_stats_entries(ppe);
 	if (ppe_num_stats_entries > 0) {
 		foe_size = ppe_num_stats_entries * sizeof(*ppe->foe_stats);
