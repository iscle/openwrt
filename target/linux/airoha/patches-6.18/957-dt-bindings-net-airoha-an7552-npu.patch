Subject: [PATCH] dt-bindings: net: airoha: describe AN7552 NPU

Describe its two cores, shared buffers and Ethernet frame-engine link.

---
--- a/Documentation/devicetree/bindings/net/airoha,en7581-npu.yaml
+++ b/Documentation/devicetree/bindings/net/airoha,en7581-npu.yaml
@@ -4,7 +4,7 @@
 $id: http://devicetree.org/schemas/net/airoha,en7581-npu.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Airoha Network Processor Unit for EN7581 SoC
+title: Airoha Network Processor Unit
 
 maintainers:
   - Lorenzo Bianconi <lorenzo@kernel.org>
@@ -17,45 +17,87 @@
 properties:
   compatible:
     enum:
+      - airoha,an7552-npu
       - airoha,en7581-npu
+
+  airoha,eth:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Ethernet frame engine providing the NPU TDMA queues.
 
   reg:
     maxItems: 1
 
   interrupts:
-    items:
-      - description: mbox host irq line
-      - description: watchdog0 irq line
-      - description: watchdog1 irq line
-      - description: watchdog2 irq line
-      - description: watchdog3 irq line
-      - description: watchdog4 irq line
-      - description: watchdog5 irq line
-      - description: watchdog6 irq line
-      - description: watchdog7 irq line
-      - description: wlan irq line0
-      - description: wlan irq line1
-      - description: wlan irq line2
-      - description: wlan irq line3
-      - description: wlan irq line4
-      - description: wlan irq line5
+    minItems: 9
+    maxItems: 15
 
   memory-region:
     oneOf:
       - items:
           - description: NPU firmware binary region
+          - description: NPU shared packet and descriptor buffers region
       - items:
           - description: NPU firmware binary region
-          - description: NPU wlan offload RX buffers region
+      - items:
+          - description: NPU firmware binary region
+          - description: NPU shared packet and descriptor buffers region
           - description: NPU wlan offload TX buffers region
           - description: NPU wlan offload TX packet identifiers region
 
   memory-region-names:
+    minItems: 1
     items:
       - const: firmware
       - const: pkt
       - const: tx-pkt
       - const: tx-bufid
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          const: airoha,an7552-npu
+    then:
+      required:
+        - airoha,eth
+      properties:
+        interrupts:
+          items:
+            - description: mbox host irq line
+            - description: watchdog0 irq line
+            - description: watchdog1 irq line
+            - description: wlan irq line0
+            - description: wlan irq line1
+            - description: wlan irq line2
+            - description: wlan irq line3
+            - description: wlan irq line4
+            - description: wlan irq line5
+        memory-region:
+          minItems: 2
+          maxItems: 2
+        memory-region-names:
+          minItems: 2
+          maxItems: 2
+    else:
+      properties:
+        airoha,eth: false
+        interrupts:
+          items:
+            - description: mbox host irq line
+            - description: watchdog0 irq line
+            - description: watchdog1 irq line
+            - description: watchdog2 irq line
+            - description: watchdog3 irq line
+            - description: watchdog4 irq line
+            - description: watchdog5 irq line
+            - description: watchdog6 irq line
+            - description: watchdog7 irq line
+            - description: wlan irq line0
+            - description: wlan irq line1
+            - description: wlan irq line2
+            - description: wlan irq line3
+            - description: wlan irq line4
+            - description: wlan irq line5
 
 required:
   - compatible
