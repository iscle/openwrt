 /* Destructors cannot return an error to prevent devres from freeing DMA
  * backing. If ownership cannot be proved, stop the kernel before any caller
  * can release that memory. Ordinary reset failures remain quarantined and
  * do not use this destructor-only guard.
  */
-void an7552_npu_require_quiescent(struct an7552_npu *ctx)
+static void __an7552_npu_require_quiescent(struct an7552_npu *ctx)
 {
 	if (!ctx || !ctx->running)
 		return;
-	an7552_npu_stop(ctx);
-	if (an7552_npu_recovery_ready(ctx) && !halt_cores(ctx))
+	__an7552_npu_stop(ctx);
+	if (__an7552_npu_recovery_ready(ctx) && !halt_cores(ctx))
 		return;
 	/* A timed restart could enter the bootloader while a bus owner lives. */
 	WRITE_ONCE(panic_timeout, 0);
 	panic("AN7552 DMA ownership unresolved during teardown; power cycle required");
+}
+
+void an7552_npu_require_quiescent(struct an7552_npu *ctx)
+{
+	if (!ctx)
+		return;
+	if (!an7552_npu_setup_enter(ctx)) {
+		/* A terminal shutdown owns the proof. Do not let a concurrent
+		 * destructor free DMA backing until it has actually completed.
+		 */
+		wait_event(ctx->setup_wait, smp_load_acquire(&ctx->shutdown_complete));
+		return;
+	}
+	__an7552_npu_require_quiescent(ctx);
+	an7552_npu_setup_exit(ctx);
 }
 EXPORT_SYMBOL_GPL(an7552_npu_require_quiescent);
 
