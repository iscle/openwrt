-
+void an7552_npu_shutdown(struct an7552_npu *ctx)
+{
 	if (!ctx)
 		return;
 	mutex_lock(&ctx->attach_lock);
-	an7552_npu_require_quiescent(ctx);
-	ctx->running = false;
+	if (!ctx->shutdown_complete) {
