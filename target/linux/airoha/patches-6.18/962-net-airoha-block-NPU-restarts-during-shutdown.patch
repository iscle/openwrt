Subject: [PATCH] net: airoha: close NPU setup admission before shutdown

A radio reset worker can otherwise restart the NPU and TDMA after the
supplier shutdown callback proved quiescence. Serialize terminal shutdown
with every restart-capable public API without sleeping in atomic setup
callers. Retain the closed state across full recovery and reattachment.

---
--- a/drivers/net/ethernet/airoha/an7552_npu.c
+++ b/drivers/net/ethernet/airoha/an7552_npu.c
@@ -13,16 +13,17 @@
 #include <linux/of_platform.h>
 #include <linux/of_reserved_mem.h>
 #include <linux/platform_device.h>
 #include <linux/panic.h>
 #include <linux/seq_file.h>
 #include <linux/spinlock.h>
 #include <linux/soc/airoha/an7552_npu.h>
 #include <linux/unaligned.h>
+#include <linux/wait.h>
 #include "an7552_npu_fw.h"
 
 #define CODE_BASE 0x84000000
 #define CODE_SIZE 0x400000
 #define PACKET_SIZE 0x1600000
 #define BOOT_TRIGGER 0x306000
 #define BOOT_CONFIG 0x306004
 #define BOOT_PC(core) (0x306020 + (core) * 4)
@@ -39,16 +40,24 @@
 	u32 band;
 };
 
 struct an7552_npu {
 	struct device *dev;
 	void __iomem *regs, *ram, *fe, *pool, *timer;
 	/* Serializes attachment, boot and teardown of the radio consumer. */
 	struct mutex attach_lock;
+	/* Setup can be entered under an mt76 queue spinlock. Shutdown closes
+	 * admission, waits for existing users, then proves DMA quiescence.
+	 */
+	spinlock_t setup_lock;
+	wait_queue_head_t setup_wait;
+	unsigned int setup_users;
+	bool shutdown;
+	bool shutdown_complete;
 	/* Serializes station table updates with the two-core quiesce handshake. */
 	spinlock_t station_lock;
 	/* Protects the shared replay command mailbox and staging buffer. */
 	spinlock_t pn_lock;
 	bool attached, running, failed, stopping, pn_failed;
 	bool ppe_enabled, tdma_enabled;
 	bool faulted, fault_quiesced;
 	bool pn_domains_initialized;
@@ -70,16 +79,57 @@
 
 	void (*txfree_notify[2])(void *);
 	void *txfree_context[2];
 	struct an7552_npu_irq txfree_bands[2];
 	void (*rro_notify)(void *context);
 	void *rro_context;
 	struct dentry *debugfs;
 };
+
+static bool an7552_npu_setup_enter(struct an7552_npu *ctx)
+{
+	unsigned long flags;
+	bool admitted;
+
+	spin_lock_irqsave(&ctx->setup_lock, flags);
+	admitted = !ctx->shutdown;
+	if (admitted)
+		ctx->setup_users++;
+	spin_unlock_irqrestore(&ctx->setup_lock, flags);
+	return admitted;
+}
+
+static void an7552_npu_setup_exit(struct an7552_npu *ctx)
+{
+	unsigned long flags;
+	bool idle;
+
+	spin_lock_irqsave(&ctx->setup_lock, flags);
+	idle = !--ctx->setup_users;
+	spin_unlock_irqrestore(&ctx->setup_lock, flags);
+	if (idle)
+		wake_up_all(&ctx->setup_wait);
+}
+
+/* Called in process context with attach_lock held. A stuck setup must
+ * never allow shutdown to continue into DDR reuse by the bootloader.
+ */
+static void an7552_npu_close_setup(struct an7552_npu *ctx)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&ctx->setup_lock, flags);
+	ctx->shutdown = true;
+	spin_unlock_irqrestore(&ctx->setup_lock, flags);
+	wait_event(ctx->setup_wait, !READ_ONCE(ctx->setup_users));
+	/* Pair with the last exit's unlock even when wait_event did not sleep. */
+	spin_lock_irqsave(&ctx->setup_lock, flags);
+	spin_unlock_irqrestore(&ctx->setup_lock, flags);
+}
 
