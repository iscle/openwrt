+	u8 num_cores;
+	bool legacy_wifi;
 	struct airoha_npu_fw fw_rv32;
 	struct airoha_npu_fw fw_data;
 };
@@ -168,7 +170,7 @@
 
 static int __airoha_npu_send_msg(struct airoha_npu *npu, int func_id,
 				 const void *data, int len, void *reply,
-				 u16 reply_len)
+				 u16 reply_len, bool sleepable)
 {
 	struct airoha_npu_core *core = &npu->cores[0]; /* FIXME: core */
 	u32 val, offset = 0;
@@ -189,6 +191,11 @@
 	 * foe_commit under atomic context).
 	 */
 	spin_lock_bh(&core->lock);
+	if (core->mbox_busy) {
+		spin_unlock_bh(&core->lock);
+		return -EBUSY;
+	}
+	core->mbox_busy = true;
 
 	memcpy(core->buf, data, len);
 
@@ -199,10 +206,20 @@
 	val = FIELD_PREP(MBOX_MSG_FUNC_ID, func_id) | MBOX_MSG_WAIT_RSP;
 	regmap_write(npu->regmap, REG_CR_MBQ0_CTRL(3) + offset, val);
 
-	ret = regmap_read_poll_timeout_atomic(npu->regmap,
-					      REG_CR_MBQ0_CTRL(3) + offset,
-					      val, (val & MBOX_MSG_DONE),
-					      100, 100 * MSEC_PER_SEC);
+	if (sleepable) {
+		/* Legacy WLAN cleanup includes two mandatory 100 ms waits. */
+		spin_unlock_bh(&core->lock);
+		ret = regmap_read_poll_timeout(npu->regmap,
+					       REG_CR_MBQ0_CTRL(3) + offset,
+					       val, (val & MBOX_MSG_DONE),
+					       1000, USEC_PER_SEC);
+		spin_lock_bh(&core->lock);
+	} else {
+		ret = regmap_read_poll_timeout_atomic(npu->regmap,
+						      REG_CR_MBQ0_CTRL(3) + offset,
+						      val, (val & MBOX_MSG_DONE),
+						      100, 100 * MSEC_PER_SEC);
+	}
 	if (!ret && FIELD_GET(MBOX_MSG_STATUS, val) != NPU_MBOX_SUCCESS)
 		ret = -EINVAL;
 
@@ -210,6 +227,7 @@
 	if (!ret && reply)
 		memcpy(reply, core->buf + len - reply_len, reply_len);
 
+	core->mbox_busy = false;
 	spin_unlock_bh(&core->lock);
 
 	return ret;
@@ -218,7 +236,7 @@
 static int airoha_npu_send_msg(struct airoha_npu *npu, int func_id,
 			       void *data, int len)
 {
-	return __airoha_npu_send_msg(npu, func_id, data, len, data, len);
+	return __airoha_npu_send_msg(npu, func_id, data, len, data, len, false);
 }
 
 static int airoha_npu_load_firmware(struct device *dev, void __iomem *addr,
@@ -302,6 +320,87 @@
 					soc->fw_data.max_size);
 }
 
+static void airoha_npu_an7552_halt(struct airoha_npu *npu)
+{
+	u32 mask = BIT(npu->num_cores) - 1;
+
+	regmap_write(npu->regmap, REG_CR_BOOT_CONFIG, mask << 8);
+	regmap_write(npu->regmap, REG_CR_BOOT_TRIGGER, 2);
+	usleep_range(1000, 2000);
+}
+
+static void airoha_npu_an7552_stop(struct airoha_npu *npu)
+{
+	u32 data = 0, busy = 1;
+	int i, err;
+
+	for (i = 0; i < 2; i++)
+		regmap_write(npu->regmap, REG_IRQ_RXDONE(i), 0);
+	if (!npu->wlan_running)
+		return;
+
+	err = npu->ops.wlan_send_msg(npu, 4,
+				      WLAN_FUNC_SET_WAIT_INODE_TXRX_REG_ADDR,
+				      &data, sizeof(data), GFP_KERNEL);
+	if (err)
+		goto fail;
+	for (i = 0; i < 100; i++) {
+		err = npu->ops.wlan_get_msg(npu, 3, WLAN_FUNC_GET_WAIT_NPU_INFO,
+					 &busy, sizeof(busy), GFP_KERNEL);
+		if (err || !busy)
+			break;
+		usleep_range(1000, 2000);
+	}
+	if (err || busy) {
+		err = err ?: -ETIMEDOUT;
+		goto fail;
+	}
+	err = npu->ops.wlan_send_msg(npu, 6,
+				      WLAN_FUNC_SET_WAIT_INODE_TXRX_REG_ADDR,
+				      &data, sizeof(data), GFP_KERNEL);
+	if (err)
+		goto fail;
+	npu->wlan_running = false;
+	return;
+fail:
+	/* Do not reuse uncertain DMA state after a firmware failure. */
+	dev_err(npu->dev, "WLAN quiesce failed: %d; offload disabled\n", err);
+	airoha_npu_an7552_halt(npu);
+	npu->wlan_running = false;
+	npu->wlan_failed = true;
+}
+
+static int airoha_npu_an7552_start(struct airoha_npu *npu)
+{
+	return npu->wlan_failed ? -EIO : 0;
+}
+
+static void *airoha_npu_an7552_alloc_rx_ring(struct airoha_npu *npu, int qid,
+					     size_t size, dma_addr_t *addr)
+{
+	if (qid < 0 || qid >= ARRAY_SIZE(npu->wlan_rx) || npu->wlan_running)
+		return ERR_PTR(-EINVAL);
+
+	/* Firmware caches these addresses for its entire lifetime. */
+	if (!npu->wlan_rx[qid].desc) {
+		npu->wlan_rx[qid].desc = dmam_alloc_coherent(npu->dev, size,
+							     &npu->wlan_rx[qid].addr,
+							     GFP_KERNEL);
+		if (!npu->wlan_rx[qid].desc)
+			return ERR_PTR(-ENOMEM);
+		npu->wlan_rx[qid].size = size;
+	} else if (size != npu->wlan_rx[qid].size) {
+		return ERR_PTR(-EINVAL);
+	}
+
+	memset(npu->wlan_rx[qid].desc, 0, size);
+	regmap_write(npu->regmap, REG_RX_CPU_IDX(qid), 0);
+	regmap_write(npu->regmap, REG_RX_DMA_IDX(qid), 0);
+	*addr = npu->wlan_rx[qid].addr;
+
+	return npu->wlan_rx[qid].desc;
+}
+
 static irqreturn_t airoha_npu_mbox_handler(int irq, void *npu_instance)
 {
 	struct airoha_npu *npu = npu_instance;
@@ -347,10 +446,20 @@
 	int c = core - &npu->cores[0];
 	u32 val;
 
-	regmap_set_bits(npu->regmap, REG_WDT_TIMER_CTRL(c), WDT_INTR_MASK);
-	if (!regmap_read(npu->regmap, REG_WDT_TIMER_CTRL(c), &val) &&
-	    FIELD_GET(WDT_EN_MASK, val))
-		schedule_work(&core->wdt_work);
+	if (npu->wlan_rx_only) {
+		regmap_read(npu->regmap, REG_WDT_TIMER_CTRL(0), &val);
+		if (!(val & BIT(21 + c)))
+			return IRQ_NONE;
+		regmap_write(npu->regmap, REG_WDT_TIMER_CTRL(0),
+			     (val & 0x1e0001ef) | BIT(21 + c));
+		if (val & BIT(25 + c))
+			schedule_work(&core->wdt_work);
+	} else {
+		regmap_set_bits(npu->regmap, REG_WDT_TIMER_CTRL(c), WDT_INTR_MASK);
+		if (!regmap_read(npu->regmap, REG_WDT_TIMER_CTRL(c), &val) &&
+		    FIELD_GET(WDT_EN_MASK, val))
+			schedule_work(&core->wdt_work);
+	}
 
 	return IRQ_HANDLED;
 }
@@ -490,7 +599,16 @@
 				    void *data, int data_len, gfp_t gfp)
 {
 	struct wlan_mbox_data *wlan_data;
