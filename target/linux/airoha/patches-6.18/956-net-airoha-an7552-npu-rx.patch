+	cleanup = npu->wlan_rx_only && ifindex == 6 &&
+		  func_id == WLAN_FUNC_SET_WAIT_INODE_TXRX_REG_ADDR;
+	if (cleanup && !gfpflags_allow_blocking(gfp))
