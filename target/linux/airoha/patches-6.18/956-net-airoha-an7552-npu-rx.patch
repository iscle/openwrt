 	len = sizeof(*wlan_data) + data_len;
 	wlan_data = kzalloc(len, gfp);
@@ -502,7 +620,13 @@
 	wlan_data->func_id = func_id;
 	memcpy(wlan_data->d, data, data_len);
 
-	err = airoha_npu_send_msg(npu, NPU_FUNC_WIFI, wlan_data, len);
+	/* A lost start acknowledgment must still trigger teardown. */
+	if (npu->wlan_rx_only && ifindex == 2 &&
+	    func_id == WLAN_FUNC_SET_WAIT_INODE_TXRX_REG_ADDR)
+		npu->wlan_running = true;
+
+	err = __airoha_npu_send_msg(npu, NPU_FUNC_WIFI, wlan_data, len,
+				    wlan_data, len, cleanup);
 	kfree(wlan_data);
 
 	return err;
@@ -514,6 +638,9 @@
 {
 	struct wlan_mbox_data *wlan_data;
 	int err, len;
+
+	if (npu->wlan_rx_only && func_id > WLAN_FUNC_GET_WAIT_RING_SIZE)
+		return -EOPNOTSUPP;
 
 	len = sizeof(*wlan_data) + data_len;
 	wlan_data = kzalloc(len, gfp);
@@ -525,7 +652,7 @@
 	wlan_data->func_id = func_id;
 
 	err = __airoha_npu_send_msg(npu, NPU_FUNC_WIFI, wlan_data, len,
-				    data, data_len);
+				    data, data_len, false);
 	kfree(wlan_data);
 
 	return err;
@@ -562,20 +689,24 @@
 	if (err)
 		return err;
 
-	cmd = WLAN_FUNC_SET_WAIT_TX_BUF_CHECK_ADDR;
-	err = airoha_npu_wlan_set_reserved_memory(npu, 0, "tx-bufid", cmd);
-	if (err)
-		return err;
+	if (!npu->wlan_rx_only) {
+		cmd = WLAN_FUNC_SET_WAIT_TX_BUF_CHECK_ADDR;
+		err = airoha_npu_wlan_set_reserved_memory(npu, 0, "tx-bufid", cmd);
+		if (err)
+			return err;
+	}
 
 	cmd = WLAN_FUNC_SET_WAIT_PKT_BUF_ADDR;
 	err = airoha_npu_wlan_set_reserved_memory(npu, 0, "pkt", cmd);
 	if (err)
 		return err;
 
-	cmd = WLAN_FUNC_SET_WAIT_TX_PKT_BUF_ADDR;
-	err = airoha_npu_wlan_set_reserved_memory(npu, 0, "tx-pkt", cmd);
-	if (err)
-		return err;
+	if (!npu->wlan_rx_only) {
+		cmd = WLAN_FUNC_SET_WAIT_TX_PKT_BUF_ADDR;
+		err = airoha_npu_wlan_set_reserved_memory(npu, 0, "tx-pkt", cmd);
+		if (err)
+			return err;
+	}
 
 	if (of_property_match_string(npu->dev->of_node, "memory-region-names",
 				     "ba") >= 0) {
@@ -680,6 +811,7 @@
 EXPORT_SYMBOL_GPL(airoha_npu_put);
 
