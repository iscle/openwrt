From: Iscle <albertiscle9@gmail.com>
Subject: [PATCH] cpufreq: airoha: divide the AN7563 CPU clock during firmware handoff

The AN7563 firmware mux sequence can corrupt execution when switching
through 800 MHz. This also reproduces with Xiaomi's stock kernel/driver.
Use the vendor-defined MCU /2 divider while the SMC changes the PLL and
restore it afterward with both cores quiesced. Keep all operating points.

The AN7563 register resource is explicit and other SoCs retain their
existing firmware path. Validate the frequency instead of trusting the
vendor setter's unconditional -2 return value.

Signed-off-by: Iscle <albertiscle9@gmail.com>
---
--- a/drivers/pmdomain/mediatek/airoha-cpu-pmdomain.c
+++ b/drivers/pmdomain/mediatek/airoha-cpu-pmdomain.c
@@ -3,6 +3,9 @@
 #include <linux/arm-smccc.h>
 #include <linux/bitfield.h>
 #include <linux/clk-provider.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/stop_machine.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
 #include <linux/pm_domain.h>
@@ -16,9 +19,14 @@
 #define AIROHA_AVS_OP_GET_FREQ			(AIROHA_AVS_OP_BASE | \
 						 FIELD_PREP(AIROHA_AVS_OP_MASK, 0x2))
 
+/* Vendor clk_divider_config[] encoding for the MCU bus/CPU divider. */
+#define AN7563_CPU_DIV_MASK	GENMASK(21, 17)
+#define AN7563_CPU_DIV_2		FIELD_PREP(AN7563_CPU_DIV_MASK, 0x0a)
+
 struct airoha_cpu_pmdomain_priv {
 	struct clk_hw hw;
 	struct generic_pm_domain pd;
+	void __iomem *cpu_div;
 };
 
 static int airoha_cpu_pmdomain_clk_determine_rate(struct clk_hw *hw,
@@ -51,10 +59,61 @@
 	.determine_rate = airoha_cpu_pmdomain_clk_determine_rate,
 };
 
+struct an7563_cpu_transition {
+	struct airoha_cpu_pmdomain_priv *priv;
+	unsigned int state;
+};
+
+static int an7563_cpu_set_rate(void *data)
+{
+	struct an7563_cpu_transition *transition = data;
+	void __iomem *reg = transition->priv->cpu_div;
+	struct arm_smccc_res res;
+	u32 value, saved_div;
+
+	/*
+	 * AN7563 vendor firmware switches the shared CPU mux via PLL2 while
+	 * changing ARMPLL. Switching to/from the 800 MHz operating point can
+	 * corrupt execution, including with the stock kernel and SMC driver.
+	 * Keep the downstream CPU divider at /2 during the mux handoff, then
+	 * restore it after firmware has selected the requested PLL rate.
+	 * Preserve the mux/gate fields modified by firmware when restoring.
+	 * stop_machine keeps other CPUs out of the shared clock registers.
+	 */
+	value = readl(reg);
+	saved_div = value & AN7563_CPU_DIV_MASK;
+	writel((value & ~AN7563_CPU_DIV_MASK) | AN7563_CPU_DIV_2, reg);
+	readl(reg);
+	udelay(20);
+
+	arm_smccc_smc(AIROHA_SIP_AVS_HANDLE, AIROHA_AVS_OP_FREQ_DYN_ADJ,
+		      0, transition->state, 0, 0, 0, 0, &res);
+
+	value = readl(reg);
+	writel((value & ~AN7563_CPU_DIV_MASK) | saved_div, reg);
+	readl(reg);
+	udelay(20);
+
+	/* This firmware returns -2 even on success; validate the actual rate. */
+	arm_smccc_smc(AIROHA_SIP_AVS_HANDLE, AIROHA_AVS_OP_GET_FREQ,
+		      0, 0, 0, 0, 0, 0, &res);
+	return res.a0 == 500 + transition->state * 50 ? 0 : -EIO;
+}
+
 static int airoha_cpu_pmdomain_set_performance_state(struct generic_pm_domain *domain,
 						     unsigned int state)
 {
+	struct airoha_cpu_pmdomain_priv *priv =
+		container_of(domain, struct airoha_cpu_pmdomain_priv, pd);
 	struct arm_smccc_res res;
+
+	if (priv->cpu_div) {
+		struct an7563_cpu_transition transition = { priv, state };
+
+		if (state > 10)
+			return -EINVAL;
+		return stop_machine(an7563_cpu_set_rate, &transition, NULL);
+	}
 
 	arm_smccc_1_1_invoke(AIROHA_SIP_AVS_HANDLE, AIROHA_AVS_OP_FREQ_DYN_ADJ,
 			     0, state, 0, 0, 0, 0, &res);
@@ -80,6 +139,12 @@
 	if (!priv)
 		return -ENOMEM;
 
+	if (of_device_is_compatible(dev->of_node, "airoha,an7563-cpufreq")) {
+		priv->cpu_div = devm_platform_ioremap_resource(pdev, 0);
+		if (IS_ERR(priv->cpu_div))
+			return PTR_ERR(priv->cpu_div);
+	}
+
 	/* Init and register a get-only clk for Cpufreq */
 	priv->hw.init = &init;
 	ret = devm_clk_hw_register(dev, &priv->hw);
@@ -124,6 +189,7 @@
 }
 
 static const struct of_device_id airoha_cpu_pmdomain_of_match[] = {
+	{ .compatible = "airoha,an7563-cpufreq" },
 	{ .compatible = "airoha,an7583-cpufreq" },
 	{ .compatible = "airoha,en7581-cpufreq" },
 	{ },
--- a/drivers/cpufreq/airoha-cpufreq.c
+++ b/drivers/cpufreq/airoha-cpufreq.c
@@ -108,6 +108,7 @@
 };
 
 static const struct of_device_id airoha_cpufreq_match_list[] __initconst = {
+	{ .compatible = "airoha,an7563" },
 	{ .compatible = "airoha,an7583" },
 	{ .compatible = "airoha,en7581" },
 	{},
