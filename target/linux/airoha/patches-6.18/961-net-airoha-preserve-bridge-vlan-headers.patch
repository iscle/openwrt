Subject: [PATCH] net: airoha: preserve VLAN headers in bridge subflows

A bridge redirect without VLAN actions currently programs an empty output
tag stack. Tagged traffic works through the CPU bridge until the PPE entry
binds, then loses its VLAN header and stops reaching its destination.

For bridge rules without VLAN actions, derive the output stack from the
triggering packet, including an accelerated outer tag. Preserve per-packet
PCP and DEI, select the outer TPID independently of tag count, and update
the DSA tag mode to match the preserved stack. Reject unsupported stacks
instead of binding an entry with different encapsulation.

VLAN pushes insert an outer tag, so build their stack in reverse action
order. Carry the requested priority and choose the outer TPID from its
protocol rather than the stack depth. Cancel pushes against subsequent pops
and retain the number of original tags removed. For partial rewrites, the
single hardware PCP selector cannot mix fixed and preserved priorities or
shift their positions. Copy retained TCIs only for AN7563 native entries
whose lookup key includes every original TCI bit; otherwise keep the flow
in software. This does not enable native bridge classification by default.

---
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -518,6 +518,8 @@
 	struct hlist_node wlan_node;
 	struct net_device *wdma_dev;
 	bool wdma_dead;
+	bool vlan_dsa;
+	u8 vlan_pop, vlan_push;
 	u8 wdma_addr[ETH_ALEN];
 	u8 wdma_idx;
 	u16 wdma_wcid;
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -396,15 +396,17 @@
 	u32 qdata = FIELD_PREP(AIROHA_FOE_SHAPER_ID, 0x7f), ports_pad, val;
 	int wlan_etype = -EINVAL, dsa_port = airoha_get_dsa_port(&netdev);
 	struct airoha_foe_mac_info_common *l2;
-	u8 smac_id = 0xf;
+	u8 smac_id = 0xf, vpm = 0;
 
 	memset(hwe, 0, sizeof(*hwe));
+	if (data->vlan.num)
+		vpm = data->vlan.hdr[0].proto == htons(ETH_P_8021AD) ? 2 : 1;
 
 	val = FIELD_PREP(AIROHA_FOE_IB1_BIND_STATE, AIROHA_FOE_STATE_BIND) |
 	      FIELD_PREP(AIROHA_FOE_IB1_BIND_PACKET_TYPE, type) |
 	      FIELD_PREP(AIROHA_FOE_IB1_BIND_UDP, l4proto == IPPROTO_UDP) |
 	      FIELD_PREP(AIROHA_FOE_IB1_BIND_VLAN_LAYER, data->vlan.num) |
-	      FIELD_PREP(AIROHA_FOE_IB1_BIND_VPM, data->vlan.num) |
+	      FIELD_PREP(AIROHA_FOE_IB1_BIND_VPM, vpm) |
 	      FIELD_PREP(AIROHA_FOE_IB1_BIND_PPPOE, data->pppoe.num) |
 	      AIROHA_FOE_IB1_BIND_TTL;
 	hwe->ib1 = val;
@@ -958,9 +960,130 @@
 	spin_unlock_bh(&ppe_lock);
 }
 
+/* A bridge rule without VLAN actions must retain the packet's tag stack.
+ * Use the triggering packet, including a hardware-stripped outer tag, rather
+ * than interpreting the absence of a VLAN push as a request to strip tags.
+ */
+static int airoha_ppe_foe_preserve_vlan(struct airoha_ppe *ppe,
+					struct airoha_flow_table_entry *e,
+					struct airoha_foe_entry *hwe,
+					struct sk_buff *skb)
+{
+	__be16 proto = eth_hdr(skb)->h_proto, tpid[2];
+	int offset = skb_mac_offset(skb) + ETH_HLEN;
+	u16 tags[2] = {};
+	u32 *ib2;
+	u16 *vlan1, *vlan2, *etype;
+	u8 count = 0, vpm = 0;
+	bool preserve = true;
+	int type;
+
+	if (skb_vlan_tag_present(skb)) {
+		tags[count] = skb_vlan_tag_get(skb);
+		tpid[count++] = skb->vlan_proto;
+	}
+	while (eth_type_vlan(proto)) {
+		struct vlan_hdr buffer, *vh;
+
+		if (count == ARRAY_SIZE(tags))
+			return -EOPNOTSUPP;
+		vh = skb_header_pointer(skb, offset, sizeof(buffer), &buffer);
+		if (!vh)
+			return -EINVAL;
+		tpid[count] = proto;
+		tags[count++] = ntohs(vh->h_vlan_TCI);
+		proto = vh->h_vlan_encapsulated_proto;
+		offset += VLAN_HLEN;
+	}
+	if (count) {
+		if (tpid[0] == htons(ETH_P_8021Q))
+			vpm = 1;
+		else if (tpid[0] == htons(ETH_P_8021AD))
+			vpm = 2;
+		else
+			return -EOPNOTSUPP;
+		/* Only the outer TPID has a programmable selector. */
+		if (count == 2 && tpid[1] != htons(ETH_P_8021Q))
+			return -EOPNOTSUPP;
+	}
+
+	type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1);
+	if (airoha_is_7563(ppe->eth) && type == PPE_PKT_TYPE_BRIDGE) {
+		ib2 = &hwe->bridge_an7563.ib2;
+		vlan1 = &hwe->bridge_an7563.vlan1;
+		vlan2 = &hwe->bridge_an7563.vlan2;
+		etype = &hwe->bridge_an7563.etype;
+	} else if (type >= PPE_PKT_TYPE_IPV6_ROUTE_3T) {
+		ib2 = &hwe->ipv6.ib2;
+		vlan1 = &hwe->ipv6.l2.vlan1;
+		vlan2 = &hwe->ipv6.l2.vlan2;
+		etype = &hwe->ipv6.l2.etype;
+	} else {
+		ib2 = &hwe->bridge.ib2;
+		vlan1 = &hwe->bridge.l2.common.vlan1;
+		vlan2 = &hwe->bridge.l2.common.vlan2;
+		etype = &hwe->bridge.l2.common.etype;
+	}
+	if (e->vlan_pop || e->vlan_push) {
+		u8 pop = min_t(u8, count, e->vlan_pop);
+		u8 retained = count - pop;
+		u16 output[2] = { *vlan1, *vlan2 };
+		u32 key_mask = PPE_L2B_VID_MASK | PPE_L2B_PBITS_MASK;
+		int i;
+
+		if (retained + e->vlan_push > ARRAY_SIZE(tags))
+			return -EOPNOTSUPP;
+		if (retained) {
+			/* Shifted or mixed priorities cannot use the global PCP
+			 * selector. Copy them only if every input TCI bit is keyed.
+			 */
+			if (!airoha_is_7563(ppe->eth) ||
+			    type != PPE_PKT_TYPE_BRIDGE ||
+			    ppe->eth->soc->num_ppe != 1)
+				return -EOPNOTSUPP;
+			if (count == 2)
+				key_mask |= PPE_L2B_SECOND_VLAN_MASK;
+			if ((airoha_fe_rr(ppe->eth, REG_PPE_L2B_CFG(0)) & key_mask) !=
+			    key_mask)
+				return -EOPNOTSUPP;
+			if (e->vlan_push && tpid[pop] != htons(ETH_P_8021Q))
+				return -EOPNOTSUPP;
+		}
+		for (i = 0; i < retained; i++)
+			output[e->vlan_push + i] = tags[pop + i];
+		if (e->vlan_push)
+			vpm = FIELD_GET(AIROHA_FOE_IB1_BIND_VPM, hwe->ib1);
+		else if (retained)
+			vpm = tpid[pop] == htons(ETH_P_8021AD) ? 2 : 1;
+		else
+			vpm = 0;
+		preserve = false;
+		count = retained + e->vlan_push;
+		tags[0] = count ? output[0] : 0;
+		tags[1] = count == 2 ? output[1] : 0;
+	}
+
+	hwe->ib1 &= ~(AIROHA_FOE_IB1_BIND_VLAN_LAYER | AIROHA_FOE_IB1_BIND_VPM);
+	hwe->ib1 |= FIELD_PREP(AIROHA_FOE_IB1_BIND_VLAN_LAYER, count) |
+		    FIELD_PREP(AIROHA_FOE_IB1_BIND_VPM, vpm);
+	*vlan1 = tags[0];
+	*vlan2 = tags[1];
+	/* Preserve PCP and DEI per packet, not just those of the first packet. */
+	*ib2 &= ~AIROHA_FOE_IB2_PCP;
+	if (preserve)
+		*ib2 |= AIROHA_FOE_IB2_PCP;
+	if (e->vlan_dsa) {
+		*etype &= ~BIT(15);
+		if (!count)
+			*etype |= BIT(15);
+	}
+	return 0;
+}
+
 static int
 airoha_ppe_foe_commit_subflow_entry(struct airoha_ppe *ppe,
 				    struct airoha_flow_table_entry *e,
+				    struct sk_buff *skb,
 				    u32 hash, bool rx_wlan)
 {
 	u32 mask = AIROHA_FOE_IB1_BIND_PACKET_TYPE | AIROHA_FOE_IB1_BIND_UDP;
@@ -1024,6 +1147,11 @@
 
 	hwe.bridge.data = e->data.bridge.data;
 commit:
+	err = airoha_ppe_foe_preserve_vlan(ppe, e, &hwe, skb);
+	if (err) {
+		kfree(f);
+		return err;
+	}
 	airoha_ppe_foe_release_slot(ppe, hash);
 	err = airoha_ppe_foe_commit_entry(ppe, &hwe, hash, rx_wlan);
 	if (err) {
@@ -1101,7 +1229,7 @@
 	e = rhashtable_lookup_fast(&ppe->l2_flows, &br,
 				   airoha_l2_flow_table_params);
 	if (e)
-		airoha_ppe_foe_commit_subflow_entry(ppe, e, hash, rx_wlan);
+		airoha_ppe_foe_commit_subflow_entry(ppe, e, skb, hash, rx_wlan);
 unlock:
 	spin_unlock_bh(&ppe_lock);
 }
@@ -1388,7 +1516,7 @@
 	struct net_device *odev = NULL;
 	struct flow_action_entry *act;
 	struct airoha_foe_entry hwe;
-	u8 dsfield = 0, l4proto = 0;
+	u8 dsfield = 0, l4proto = 0, vlan_pop = 0;
 	int err, i, offload_type;
 	u16 addr_type = 0;
 
@@ -1466,14 +1594,26 @@
 			break;
 		case FLOW_ACTION_VLAN_PUSH:
 			if (data.vlan.num == 2 ||
-			    act->vlan.proto != htons(ETH_P_8021Q))
+			    (act->vlan.proto != htons(ETH_P_8021Q) &&
+			     act->vlan.proto != htons(ETH_P_8021AD)))
 				return -EOPNOTSUPP;
 
-			data.vlan.hdr[data.vlan.num].id = act->vlan.vid;
-			data.vlan.hdr[data.vlan.num].proto = act->vlan.proto;
+			/* Each push inserts a new outer tag. */
+			data.vlan.hdr[1] = data.vlan.hdr[0];
+			data.vlan.hdr[0].id = act->vlan.vid |
+					     (act->vlan.prio << VLAN_PRIO_SHIFT);
+			data.vlan.hdr[0].proto = act->vlan.proto;
 			data.vlan.num++;
 			break;
 		case FLOW_ACTION_VLAN_POP:
+			if (data.vlan.num) {
+				data.vlan.hdr[0] = data.vlan.hdr[1];
+				memset(&data.vlan.hdr[1], 0,
+				       sizeof(data.vlan.hdr[1]));
+				data.vlan.num--;
+			} else if (vlan_pop < 2) {
+				vlan_pop++;
+			}
 			break;
 		case FLOW_ACTION_PPPOE_PUSH:
 			if (data.pppoe.num == 1 || data.vlan.num == 2)
@@ -1486,6 +1626,10 @@
 			return -EOPNOTSUPP;
 		}
 	}
+
+	if (data.vlan.num == 2 &&
+	    data.vlan.hdr[1].proto != htons(ETH_P_8021Q))
+		return -EOPNOTSUPP;
 
 	if (!is_valid_ether_addr(data.eth.h_source) ||
 	    !is_valid_ether_addr(data.eth.h_dest))
@@ -1565,6 +1709,13 @@
 		return -ENOMEM;
 
 	e->cookie = f->cookie;
+	e->vlan_pop = vlan_pop;
+	e->vlan_push = data.vlan.num;
+	if (offload_type == PPE_PKT_TYPE_BRIDGE) {
+		struct net_device *dev = odev;
+
+		e->vlan_dsa = airoha_get_dsa_port(&dev) >= 0;
+	}
 	memcpy(&e->data, &hwe, sizeof(e->data));
 	if (offload_type >= PPE_PKT_TYPE_IPV6_ROUTE_3T ?
 	    FIELD_GET(AIROHA_FOE_IB2_PSE_PORT, hwe.ipv6.ib2) == FE_PSE_PORT_CDM4 :
--- a/drivers/net/ethernet/airoha/airoha_regs.h
+++ b/drivers/net/ethernet/airoha/airoha_regs.h
@@ -340,6 +340,11 @@
 #define PPE_SRAM_HASH1_EN_MASK			BIT(8)
 #define PPE_SRAM_HASH0_MODE_MASK		GENMASK(7, 4)
 #define PPE_SRAM_TABLE_EN_MASK			BIT(0)
+
+#define REG_PPE_L2B_CFG(_n)		(((_n) ? PPE2_BASE : PPE1_BASE) + 0x288)
+#define PPE_L2B_VID_MASK			BIT(2)
+#define PPE_L2B_PBITS_MASK		BIT(3)
+#define PPE_L2B_SECOND_VLAN_MASK		BIT(20)
 
 #define REG_PPE_MTU_BASE(_n)			(((_n) ? PPE2_BASE : PPE1_BASE) + 0x304)
 #define REG_PPE_MTU(_m, _n)			(REG_PPE_MTU_BASE(_m) + (((_n) / 2) << 2))
