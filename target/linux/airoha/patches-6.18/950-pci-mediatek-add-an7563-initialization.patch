+/*
+ * AN7563 uses the v2 configuration/IRQ block but external SCU resets.
+ * Sequence and PHY values follow Airoha's GPL AN7552 PCIe driver
+ * (pcie-ecnt.c and pcie-ecnt-phy.c, version 7552.1.20230912).
+ * Reset both ports once: their host-bridge reset is shared.
+ */
+static int an7563_pcie_init(struct mtk_pcie_port *port)
+{
+	static bool initialized;
+	struct device *dev = port->pcie->dev;
+	void __iomem *scu, *chip, *phy;
+	u32 val, reset_mask = BIT(26) | BIT(27) | BIT(29);
+	int i;
+
+	if (initialized)
+		return 0;
+
+	scu = ioremap(0x1fb00000, 0x900);
+	chip = ioremap(0x1fa20000, 0x200);
+	phy = ioremap(0x1fa93700, 0x2600);
+	if (!scu || !chip || !phy) {
+		iounmap(phy);
+		iounmap(chip);
+		iounmap(scu);
+		return -ENOMEM;
+	}
+
+	/* Open-drain PERST pads, assert endpoints, enable reference clocks. */
+	writel(readl(chip + 0x18c) | 7, chip + 0x18c);
+	val = readl(scu + 0x88);
+	val = (val & ~(BIT(29) | BIT(26))) | BIT(23) | BIT(22);
+	writel(val, scu + 0x88);
+	usleep_range(1000, 2000);
+	writel(readl(scu + 0x834) & ~reset_mask, scu + 0x834);
+	usleep_range(1000, 2000);
+	writel(readl(scu + 0x834) | reset_mask, scu + 0x834);
+	msleep(100);
+	writel(readl(scu + 0x834) & ~reset_mask, scu + 0x834);
+	usleep_range(5000, 6000);
+
+	for (i = 0; i < 2; i++) {
+		writel(0x0c010000, phy + i * 0x2000 + 0x418);
+		writel(0x60080007, phy + i * 0x2000 + 0x404);
+		writel(0x04100803, phy + i * 0x2000 + 0x318);
+	}
+	writel(val | BIT(29) | BIT(26), scu + 0x88);
+	msleep(250);
+	iounmap(phy);
+	iounmap(chip);
+	iounmap(scu);
+	initialized = true;
+	dev_info(dev, "AN7563 PCIe SCU/PHY initialization complete\n");
+	return 0;
+}
