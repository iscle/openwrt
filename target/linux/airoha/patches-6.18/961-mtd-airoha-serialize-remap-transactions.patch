+/* Raw NAND serializes individual operations, not the read/copy/commit
+ * transaction. Protect Airoha mappings and the shared page scratch from
+ * concurrent MTD requests, including readers using the old mapping.
+ */
+static DEFINE_MUTEX(airoha_bmt_lock);
 
