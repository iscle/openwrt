+static int airoha_locked_read(struct mtd_info *mtd, loff_t from, struct mtd_oob_ops *ops)
+{
+	int ret;
+
+	if (bmtd.ops != &airoha_bmt_ops)
+		return mtk_bmt_read(mtd, from, ops);
+	mutex_lock(&airoha_bmt_lock);
+	ret = mtk_bmt_read(mtd, from, ops);
+	mutex_unlock(&airoha_bmt_lock);
+	return ret;
+}
+
