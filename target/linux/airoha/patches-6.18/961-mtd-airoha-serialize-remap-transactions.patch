+static int airoha_locked_debug_repair(void *data, u64 val)
+{
+	/* Generic repair commits the unmap before copying data back. A cut
+	 * or copy failure would lose the only authoritative mapping.
+	 */
+	if (bmtd.ops == &airoha_bmt_ops)
+		return -EOPNOTSUPP;
+	return mtk_bmt_debug_repair(data, val);
+}
