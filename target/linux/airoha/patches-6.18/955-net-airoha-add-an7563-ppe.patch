 	u32 *ptr = (u32 *)hwe, val;
 	int i;
 
@@ -790,12 +850,12 @@ static int airoha_ppe_foe_commit_entry(struct airoha_ppe *ppe,
 	rcu_read_lock();
 
 	npu = rcu_dereference(eth->npu);
-	if (!npu) {
+	if (!npu && !airoha_is_7563(eth)) {
