+static void airoha_ppe_bridge_vlan_match_parse(struct airoha_bridge_vlan_match *vlan,
+					       struct flow_match_vlan *match)
+{
+	vlan->tpid = match->key->vlan_tpid;
+	vlan->tpid_mask = match->mask->vlan_tpid;
+	vlan->proto = match->key->vlan_eth_type;
+	vlan->proto_mask = match->mask->vlan_eth_type;
+	vlan->tci = match->key->vlan_id | match->key->vlan_dei << 12 |
+		    match->key->vlan_priority << VLAN_PRIO_SHIFT;
+	vlan->tci_mask = match->mask->vlan_id | match->mask->vlan_dei << 12 |
+			 match->mask->vlan_priority << VLAN_PRIO_SHIFT;
+}
