+static int airoha_ppe_bridge_match_parse(struct airoha_flow_table_entry *e,
+					 struct flow_rule *rule,
+					 struct net_device *odev)
+{
+	struct flow_match_eth_addrs eth;
+	struct flow_match_basic basic;
+	struct flow_match_meta meta;
+	u64 supported = BIT_ULL(FLOW_DISSECTOR_KEY_META) |
+			BIT_ULL(FLOW_DISSECTOR_KEY_CONTROL) |
+			BIT_ULL(FLOW_DISSECTOR_KEY_BASIC) |
+			BIT_ULL(FLOW_DISSECTOR_KEY_ETH_ADDRS) |
+			BIT_ULL(FLOW_DISSECTOR_KEY_VLAN) |
+			BIT_ULL(FLOW_DISSECTOR_KEY_CVLAN) |
+			BIT_ULL(FLOW_DISSECTOR_KEY_NUM_OF_VLANS);
+
+	if (rule->match.dissector->used_keys & ~supported)
+		return -EOPNOTSUPP;
+	flow_rule_match_meta(rule, &meta);
+	if (meta.mask->ingress_ifindex != -1 || meta.mask->ingress_iftype ||
+	    meta.mask->l2_miss)
+		return -EOPNOTSUPP;
+	flow_rule_match_eth_addrs(rule, &eth);
+	if (!is_broadcast_ether_addr(eth.mask->src) ||
+	    !is_broadcast_ether_addr(eth.mask->dst))
+		return -EOPNOTSUPP;
+	flow_rule_match_basic(rule, &basic);
+	if (basic.mask->ip_proto)
+		return -EOPNOTSUPP;
+	e->match.proto = basic.key->n_proto;
+	e->match.proto_mask = basic.mask->n_proto;
+	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_VLAN)) {
+		struct flow_match_vlan match;
+
+		flow_rule_match_vlan(rule, &match);
+		airoha_ppe_bridge_vlan_match_parse(&e->match.vlan[0], &match);
+	}
+	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_CVLAN)) {
+		struct flow_match_vlan match;
+
+		flow_rule_match_cvlan(rule, &match);
+		airoha_ppe_bridge_vlan_match_parse(&e->match.vlan[1], &match);
+	}
+	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_NUM_OF_VLANS)) {
+		struct flow_dissector_key_num_of_vlans *key, *mask;
+
+		key = skb_flow_dissector_target(rule->match.dissector,
+						FLOW_DISSECTOR_KEY_NUM_OF_VLANS,
+						rule->match.key);
+		mask = skb_flow_dissector_target(rule->match.dissector,
+						 FLOW_DISSECTOR_KEY_NUM_OF_VLANS,
+						 rule->match.mask);
+		e->match.num_vlans = key->num_of_vlans;
+		e->match.num_vlans_mask = mask->num_of_vlans;
+	}
+	if (!odev)
+		return -ENODEV;
+	e->ingress_dev = dev_get_by_index(dev_net(odev), meta.key->ingress_ifindex);
+	if (!e->ingress_dev)
+		return -ENODEV;
+	/* The hardware miss precedes VLAN upper-device demultiplexing. */
+	if (is_vlan_dev(e->ingress_dev))
+		return -EOPNOTSUPP;
+	return 0;
+}
