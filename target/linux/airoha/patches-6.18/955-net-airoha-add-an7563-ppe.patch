+static int
+airoha_ppe_flush_wdma_entry(struct airoha_ppe *ppe,
+			    struct airoha_flow_table_entry *e)
+{
+	struct airoha_flow_table_entry *sub;
+	struct hlist_node *next;
+	int err;
+
+	lockdep_assert_held(&ppe_lock);
+	if (e->type != FLOW_TYPE_L2) {
+		err = airoha_ppe_foe_invalidate_wdma(ppe, e->hash,
+						     e->wdma_wcid, e->wdma_idx);
+		if (!err)
+			airoha_ppe_foe_unbind_flow(ppe, e);
+		return err;
+	}
+
+	hlist_for_each_entry_safe(sub, next, &e->l2_flows, l2_subflow_node) {
+		err = airoha_ppe_foe_invalidate_wdma(ppe, sub->hash,
+						     e->wdma_wcid, e->wdma_idx);
+		if (err)
+			return err;
+		airoha_ppe_foe_remove_flow(ppe, sub);
+	}
+
 	return 0;
 }
 
+static void airoha_ppe_flush_wdma_failed(struct airoha_ppe *ppe, int err)
+{
+	int i;
+
+	/* A failed table write must not leave a reusable radio ID bound. */
+	for (i = 0; i < ppe->eth->soc->num_ppe; i++)
+		airoha_fe_clear(ppe->eth, REG_PPE_GLO_CFG(i),
+				PPE_GLO_CFG_EN_MASK);
+	dev_err(ppe->eth->dev, "PPE disabled after station flush failure: %d\n",
+		err);
+}
+
+/* Called after radio authorization is revoked, before its WCID is reused. */
+static int airoha_ppe_flush_wdma(struct airoha_ppe_dev *dev, u16 wcid, u8 band)
+{
+	struct airoha_ppe *ppe = dev->priv;
+	struct airoha_flow_table_entry *e;
+	int err = 0;
+
+	spin_lock_bh(&ppe_lock);
+	if (airoha_is_7563(ppe->eth)) {
+		unsigned int hash;
+
+		for (hash = 0; hash < airoha_ppe_get_total_num_entries(ppe); hash++) {
+			const u32 *key;
+
+			e = ppe->foe_owner[hash];
+			if (!e || e->type != FLOW_TYPE_L2_SUBFLOW ||
+			    FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, e->data.ib1) !=
+			    PPE_PKT_TYPE_BRIDGE)
+				continue;
+			key = e->data.bridge_an7563.key;
+			if (FIELD_GET(AN7563_L2_KEY_SPORT, key[2]) == 7 &&
+			    (key[1] & 0xffff) == wcid + 1)
+				airoha_ppe_foe_release_slot(ppe, hash);
+		}
+	}
+	hlist_for_each_entry(e, &ppe->wlan_flows, wlan_node) {
+		if (e->wdma_wcid != wcid || e->wdma_idx != band)
+			continue;
+		err = airoha_ppe_flush_wdma_entry(ppe, e);
+		if (err)
+			break;
+	}
+	if (err)
+		airoha_ppe_flush_wdma_failed(ppe, err);
+	spin_unlock_bh(&ppe_lock);
+
+	return err;
+}
