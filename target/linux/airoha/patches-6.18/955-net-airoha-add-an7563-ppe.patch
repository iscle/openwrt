+/* Rebinding must not reuse a station identity cached before a reconnect. */
+static int
+airoha_ppe_foe_refresh_wdma(struct airoha_flow_table_entry *e)
+{
+	struct airoha_foe_mac_info_common *l2;
+	struct airoha_wdma_info info = {};
+	u32 *ib2, *data;
+	int type, err;
+
+	if (e->wdma_dead)
+		return -ENODEV;
+	if (!e->wdma_dev)
+		return 0;
+
+	lockdep_assert_held(&ppe_lock);
+	err = airoha_ppe_get_wdma_info(e->wdma_dev, e->wdma_addr, &info);
+	if (err)
+		return err;
+
+	type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, e->data.ib1);
+	if (type >= PPE_PKT_TYPE_IPV6_ROUTE_3T) {
+		l2 = &e->data.ipv6.l2;
+		ib2 = &e->data.ipv6.ib2;
+		data = &e->data.ipv6.data;
+	} else {
+		l2 = &e->data.bridge.l2.common;
+		ib2 = &e->data.bridge.ib2;
+		data = &e->data.bridge.data;
+	}
+	l2->etype &= ~(AIROHA_FOE_MAC_WDMA_BAND | AIROHA_FOE_MAC_WDMA_WCID);
+	l2->etype |= FIELD_PREP(AIROHA_FOE_MAC_WDMA_BAND, info.idx) |
+		     FIELD_PREP(AIROHA_FOE_MAC_WDMA_WCID, info.wcid);
+	*ib2 = (*ib2 & ~AIROHA_FOE_IB2_NBQ) |
+		FIELD_PREP(AIROHA_FOE_IB2_NBQ, info.idx);
+	*data = (*data & ~AIROHA_FOE_ACTDP) |
+		FIELD_PREP(AIROHA_FOE_ACTDP, info.bss);
+	e->wdma_idx = info.idx;
+	e->wdma_wcid = info.wcid;
+
+	return 0;
+}
+
