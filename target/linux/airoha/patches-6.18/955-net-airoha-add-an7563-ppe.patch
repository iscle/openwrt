 	}
 
-	if (!rx_wlan)
+	if (!rx_wlan && npu)
 		airoha_ppe_foe_flow_stats_update(ppe, npu, hwe, hash);
 
 	if (hash < sram_num_entries)
@@ -806,25 +866,74 @@ unlock:
 	return err;
 }
 
+static void airoha_ppe_foe_write_failed(struct airoha_ppe *ppe, int err)
+{
+	int i;
+
+	/* A timed out write may have reached hardware. Stop forwarding before
+	 * releasing its software owner or any referenced destination.
+	 */
+	for (i = 0; i < ppe->eth->soc->num_ppe; i++)
+		airoha_fe_clear(ppe->eth, REG_PPE_GLO_CFG(i),
+				PPE_GLO_CFG_EN_MASK);
+	dev_err(ppe->eth->dev, "PPE disabled after flow write failure: %d\n",
+		err);
+}
+
+static void airoha_ppe_foe_unbind_flow(struct airoha_ppe *ppe,
+				       struct airoha_flow_table_entry *e)
+{
+	struct airoha_foe_entry *entry, hwe;
+	int err = 0;
+	u32 hash = e->hash;
+
+	lockdep_assert_held(&ppe_lock);
+	if (hash == 0xffff)
+		return;
+	if (ppe->foe_owner[hash] != e)
+		goto clear_hash;
+
+	entry = airoha_ppe_foe_get_entry_locked(ppe, hash);
+	if (!entry) {
+		err = -EIO;
+	} else if (FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, entry->ib1) ==
+		   AIROHA_FOE_STATE_BIND) {
+		hwe = *entry;
+		hwe.ib1 &= ~AIROHA_FOE_IB1_BIND_STATE;
+		err = airoha_ppe_foe_commit_entry(ppe, &hwe, hash, false);
+	}
+	if (err)
+		airoha_ppe_foe_write_failed(ppe, err);
+	ppe->foe_owner[hash] = NULL;
+clear_hash:
+	e->hash = 0xffff;
+}
+
 static void airoha_ppe_foe_remove_flow(struct airoha_ppe *ppe,
 				       struct airoha_flow_table_entry *e)
 {
 	lockdep_assert_held(&ppe_lock);
 
 	hlist_del_init(&e->list);
-	if (e->hash != 0xffff) {
-		e->data.ib1 &= ~AIROHA_FOE_IB1_BIND_STATE;
-		e->data.ib1 |= FIELD_PREP(AIROHA_FOE_IB1_BIND_STATE,
-					  AIROHA_FOE_STATE_INVALID);
-		airoha_ppe_foe_commit_entry(ppe, &e->data, e->hash, false);
-		e->hash = 0xffff;
-	}
+	airoha_ppe_foe_unbind_flow(ppe, e);
 	if (e->type == FLOW_TYPE_L2_SUBFLOW) {
 		hlist_del_init(&e->l2_subflow_node);
 		kfree(e);
 	}
 }
 
+static void airoha_ppe_foe_release_slot(struct airoha_ppe *ppe, u32 hash)
+{
+	struct airoha_flow_table_entry *e = ppe->foe_owner[hash];
+
+	lockdep_assert_held(&ppe_lock);
+	if (!e)
+		return;
+	airoha_ppe_foe_unbind_flow(ppe, e);
+	if (e->type == FLOW_TYPE_L2_SUBFLOW)
+		airoha_ppe_foe_remove_flow(ppe, e);
+}
