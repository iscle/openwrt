+/* The hardware miss arrives before DSA decapsulation. Resolve its input
+ * from the descriptor metadata rather than treating all switch ports as eth0.
+ */
+static bool airoha_ppe_bridge_ingress_match(struct airoha_flow_table_entry *e,
+					    struct sk_buff *skb)
+{
+	struct net_device *dev = skb->dev;
+
+	if (!e->ingress_dev || !dev)
+		return false;
+	if (e->ingress_dev == dev)
+		return true;
+#if IS_ENABLED(CONFIG_NET_DSA)
+	if (netdev_uses_dsa(dev)) {
+		struct metadata_dst *md = skb_metadata_dst(skb);
+		struct dsa_port *dp;
+
+		if (!md || md->type != METADATA_HW_PORT_MUX)
+			return false;
+		list_for_each_entry(dp, &dev->dsa_ptr->dst->ports, list)
+			if (!dp->ds->index && dp->index == md->u.port_info.port_id &&
+			    dp->type == DSA_PORT_TYPE_USER)
+				return e->ingress_dev == dp->user;
+	}
+#endif
+	return false;
+}
+
+static bool airoha_ppe_bridge_match(struct airoha_flow_table_entry *e,
+				    struct sk_buff *skb)
+{
+	struct airoha_bridge_match *match = &e->match;
+	__be16 proto = eth_hdr(skb)->h_proto;
+	int offset = skb_mac_offset(skb) + ETH_HLEN;
+	unsigned int count = 0;
+
+	if (!airoha_ppe_bridge_ingress_match(e, skb))
+		return false;
+	while (eth_type_vlan(proto) || (!count && skb_vlan_tag_present(skb))) {
+		struct airoha_bridge_vlan_match *vlan;
+		__be16 tpid = proto;
+		u16 tci;
+
+		if (count == ARRAY_SIZE(match->vlan))
+			return false;
+		if (!count && skb_vlan_tag_present(skb)) {
+			tpid = skb->vlan_proto;
+			tci = skb_vlan_tag_get(skb);
+		} else {
+			struct vlan_hdr buffer, *vh;
+
+			vh = skb_header_pointer(skb, offset, sizeof(buffer), &buffer);
+			if (!vh)
+				return false;
+			tci = ntohs(vh->h_vlan_TCI);
+			proto = vh->h_vlan_encapsulated_proto;
+			offset += VLAN_HLEN;
+		}
+		vlan = &match->vlan[count++];
+		if (((tpid ^ vlan->tpid) & vlan->tpid_mask) ||
+		    ((tci ^ vlan->tci) & vlan->tci_mask) ||
+		    ((proto ^ vlan->proto) & vlan->proto_mask))
+			return false;
+	}
+	if (((count ^ match->num_vlans) & match->num_vlans_mask) ||
+	    ((proto ^ match->proto) & match->proto_mask))
+		return false;
+	/* An absent tag must not satisfy a masked zero-valued tag condition. */
+	for (; count < ARRAY_SIZE(match->vlan); count++) {
+		struct airoha_bridge_vlan_match *vlan = &match->vlan[count];
+
+		if (vlan->tpid_mask || vlan->tci_mask || vlan->proto_mask)
+			return false;
+	}
+	return true;
+}
+
+/* A bridge rule without VLAN actions must retain the packet's tag stack.
+ * Use the triggering packet, including a hardware-stripped outer tag, rather
+ * than interpreting the absence of a VLAN push as a request to strip tags.
+ */
+static int airoha_ppe_foe_preserve_vlan(struct airoha_ppe *ppe,
+					struct airoha_flow_table_entry *e,
+					struct airoha_foe_entry *hwe,
+					struct sk_buff *skb)
+{
+	__be16 proto = eth_hdr(skb)->h_proto, tpid[2];
+	int offset = skb_mac_offset(skb) + ETH_HLEN;
+	u16 tags[2] = {};
+	u32 *ib2;
+	u16 *vlan1, *vlan2, *etype;
+	u8 count = 0, vpm = 0;
+	bool preserve = true;
+	int type;
+
+	if (skb_vlan_tag_present(skb)) {
+		tags[count] = skb_vlan_tag_get(skb);
+		tpid[count++] = skb->vlan_proto;
+	}
+	while (eth_type_vlan(proto)) {
+		struct vlan_hdr buffer, *vh;
+
+		if (count == ARRAY_SIZE(tags))
+			return -EOPNOTSUPP;
+		vh = skb_header_pointer(skb, offset, sizeof(buffer), &buffer);
+		if (!vh)
+			return -EINVAL;
+		tpid[count] = proto;
+		tags[count++] = ntohs(vh->h_vlan_TCI);
+		proto = vh->h_vlan_encapsulated_proto;
+		offset += VLAN_HLEN;
+	}
+	if (count) {
+		if (tpid[0] == htons(ETH_P_8021Q))
+			vpm = 1;
+		else if (tpid[0] == htons(ETH_P_8021AD))
+			vpm = 2;
+		else
+			return -EOPNOTSUPP;
+		/* Only the outer TPID has a programmable selector. */
+		if (count == 2 && tpid[1] != htons(ETH_P_8021Q))
+			return -EOPNOTSUPP;
+	}
+
+	type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1);
+	if (airoha_is_7563(ppe->eth) && type == PPE_PKT_TYPE_BRIDGE) {
+		ib2 = &hwe->bridge_an7563.ib2;
+		vlan1 = &hwe->bridge_an7563.vlan1;
+		vlan2 = &hwe->bridge_an7563.vlan2;
+		etype = &hwe->bridge_an7563.etype;
+	} else if (type >= PPE_PKT_TYPE_IPV6_ROUTE_3T) {
+		ib2 = &hwe->ipv6.ib2;
+		vlan1 = &hwe->ipv6.l2.vlan1;
+		vlan2 = &hwe->ipv6.l2.vlan2;
+		etype = &hwe->ipv6.l2.etype;
+	} else {
+		ib2 = &hwe->bridge.ib2;
+		vlan1 = &hwe->bridge.l2.common.vlan1;
+		vlan2 = &hwe->bridge.l2.common.vlan2;
+		etype = &hwe->bridge.l2.common.etype;
+	}
+	if (e->vlan_pop || e->vlan_push) {
+		u8 pop = min_t(u8, count, e->vlan_pop);
+		u8 retained = count - pop;
+		u16 output[2] = { *vlan1, *vlan2 };
+		u32 key_mask = PPE_L2B_VID_MASK | PPE_L2B_PBITS_MASK;
+		int i;
+
+		if (retained + e->vlan_push > ARRAY_SIZE(tags))
+			return -EOPNOTSUPP;
+		if (retained) {
+			/* Shifted or mixed priorities cannot use the global PCP
+			 * selector. Copy them only if every input TCI bit is keyed.
+			 */
+			if (!airoha_is_7563(ppe->eth) ||
+			    type != PPE_PKT_TYPE_BRIDGE ||
+			    ppe->eth->soc->num_ppe != 1)
+				return -EOPNOTSUPP;
+			if (count == 2)
+				key_mask |= PPE_L2B_SECOND_VLAN_MASK;
+			if ((airoha_fe_rr(ppe->eth, REG_PPE_L2B_CFG(0)) & key_mask) !=
+			    key_mask)
+				return -EOPNOTSUPP;
+			if (e->vlan_push && tpid[pop] != htons(ETH_P_8021Q))
+				return -EOPNOTSUPP;
+		}
+		for (i = 0; i < retained; i++)
+			output[e->vlan_push + i] = tags[pop + i];
+		if (e->vlan_push)
+			vpm = FIELD_GET(AIROHA_FOE_IB1_BIND_VPM, hwe->ib1);
+		else if (retained)
+			vpm = tpid[pop] == htons(ETH_P_8021AD) ? 2 : 1;
+		else
+			vpm = 0;
+		preserve = false;
+		count = retained + e->vlan_push;
+		tags[0] = count ? output[0] : 0;
+		tags[1] = count == 2 ? output[1] : 0;
+	}
+
+	hwe->ib1 &= ~(AIROHA_FOE_IB1_BIND_VLAN_LAYER | AIROHA_FOE_IB1_BIND_VPM);
+	hwe->ib1 |= FIELD_PREP(AIROHA_FOE_IB1_BIND_VLAN_LAYER, count) |
+		    FIELD_PREP(AIROHA_FOE_IB1_BIND_VPM, vpm);
+	*vlan1 = tags[0];
+	*vlan2 = tags[1];
+	/* Preserve PCP and DEI per packet, not just those of the first packet. */
+	*ib2 &= ~AIROHA_FOE_IB2_PCP;
+	if (preserve)
+		*ib2 |= AIROHA_FOE_IB2_PCP;
+	if (e->vlan_dsa) {
+		*etype &= ~BIT(15);
+		if (!count)
+			*etype |= BIT(15);
+	}
+	return 0;
+}
+
+/* Keep switch inputs in a separate source-port range. The hardware key
+ * includes all five bits: GDM1 occupies 24..28, GDM2 uses 2 and NPU uses 7.
+ */
+static int airoha_ppe_bridge_source_port(struct airoha_ppe *ppe,
+					 struct sk_buff *skb)
+{
+	struct airoha_eth *eth = ppe->eth;
+	unsigned int i, j;
+
+	for (i = 0; i < ARRAY_SIZE(eth->ports); i++) {
+		struct airoha_gdm_port *port = eth->ports[i];
+
+		if (!port)
+			continue;
+		for (j = 0; j < ARRAY_SIZE(port->devs); j++) {
+			struct airoha_gdm_dev *gdm = port->devs[j];
+
+			if (!gdm || netdev_from_priv(gdm) != skb->dev)
+				continue;
+			if (port->id == AIROHA_GDM2_IDX)
+				return 2;
+#if IS_ENABLED(CONFIG_NET_DSA)
+			if (port->id == AIROHA_GDM1_IDX && netdev_uses_dsa(skb->dev)) {
+				struct metadata_dst *md = skb_metadata_dst(skb);
+
+				if (md && md->type == METADATA_HW_PORT_MUX &&
+				    md->u.port_info.port_id < 5)
+					return 24 + md->u.port_info.port_id;
+			}
+#endif
+			return -EOPNOTSUPP;
+		}
+	}
+	return -ENODEV;
+}
+
+static bool airoha_ppe_native_bridge_match(struct airoha_ppe *ppe,
+					   struct airoha_foe_entry *hwe,
+					   struct sk_buff *skb, u16 domain)
+{
+	const struct ethhdr *eh = eth_hdr(skb);
+	const u32 *key = hwe->bridge_an7563.key;
+	__be16 proto = eh->h_proto, tpid = 0;
+	int offset = skb_mac_offset(skb) + ETH_HLEN;
+	u32 hsk;
+	u16 tci = 0;
+	int port;
+
+	if (key[0] != get_unaligned_be32(eh->h_dest) ||
+	    key[1] >> 16 != get_unaligned_be16(eh->h_dest + 4) ||
+	    key[3] != get_unaligned_be32(eh->h_source) ||
+	    key[4] >> 16 != get_unaligned_be16(eh->h_source + 4))
+		return false;
+	if (domain) {
+		/* Firmware only tags complete, untagged IP frames. */
+		if (domain > 2048 || skb_vlan_tag_present(skb) || eth_type_vlan(proto))
+			return false;
+		tci = domain;
+		tpid = htons(ETH_P_8021Q);
+		port = 7;
+	} else {
+		port = airoha_ppe_bridge_source_port(ppe, skb);
+		if (port < 0)
+			return false;
+		if (skb_vlan_tag_present(skb)) {
+			tci = skb_vlan_tag_get(skb);
+			tpid = skb->vlan_proto;
+		} else if (eth_type_vlan(proto)) {
+			struct vlan_hdr buffer, *vh;
+
+			vh = skb_header_pointer(skb, offset, sizeof(buffer), &buffer);
+			if (!vh)
+				return false;
+			tci = ntohs(vh->h_vlan_TCI);
+			tpid = proto;
+			proto = vh->h_vlan_encapsulated_proto;
+		}
+	}
+	/* AN7552 collapses double-tag TPIDs and arbitrary non-IP EtherTypes.
+	 * Those keys cannot represent a Linux bridge rule without ambiguity.
+	 */
+	if (proto == htons(ETH_P_IP))
+		hsk = AN7563_L2_KEY_IPV4;
+	else if (proto == htons(ETH_P_IPV6))
+		hsk = AN7563_L2_KEY_IPV6;
+	else
+		return false;
+	if (tpid == htons(ETH_P_8021Q))
+		hsk |= AN7563_L2_KEY_CTAG;
+	else if (tpid == htons(ETH_P_8021AD))
+		hsk |= AN7563_L2_KEY_STAG;
+	else if (tpid)
+		return false;
+	hsk |= port;
+
+	return (key[1] & 0xffff) == tci && key[2] == hsk;
+}
+
+/* Receive notifications can outlive an unbound hardware entry. Do not
+ * attach a bridge action to a recycled slot based on the old packet's MACs.
+ */
+static bool airoha_ppe_foe_packet_match(struct airoha_ppe *ppe,
+					struct airoha_foe_entry *hwe,
+					struct sk_buff *skb)
+{
+	int type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1);
+	int offset = skb_mac_offset(skb) + ETH_HLEN;
+	__be16 proto = eth_hdr(skb)->h_proto;
+	struct flow_keys keys = {};
+	__be32 ports_buffer;
+	bool ports;
+	int i;
+
+	if (airoha_is_7563(ppe->eth) && type == PPE_PKT_TYPE_BRIDGE) {
+		const struct ethhdr *eh = eth_hdr(skb);
+		const u32 *key = hwe->bridge_an7563.key;
+
+		/* Native classification remains disabled until all key fields
+		 * distinguish supported ingress domains. Check the MAC fields
+		 * here as well, without claiming that they are the complete key.
+		 */
+		return key[0] == get_unaligned_be32(eh->h_dest) &&
+		       key[1] >> 16 == get_unaligned_be16(eh->h_dest + 4) &&
+		       key[3] == get_unaligned_be32(eh->h_source) &&
+		       key[4] >> 16 == get_unaligned_be16(eh->h_source + 4);
+	}
+	/* Parse inline tags explicitly: Wi-Fi has not called eth_type_trans()
+	 * yet, and DSA may have replaced skb->protocol with ETH_P_XDSA.
+	 */
+	for (i = 0; eth_type_vlan(proto); i++) {
+		struct vlan_hdr buffer, *vh;
+
+		if (i == 2)
+			return false;
+		vh = skb_header_pointer(skb, offset, sizeof(buffer), &buffer);
+		if (!vh)
+			return false;
+		proto = vh->h_vlan_encapsulated_proto;
+		offset += VLAN_HLEN;
+	}
+	if (proto != htons(ETH_P_IP) && proto != htons(ETH_P_IPV6))
+		return false;
+	if (!__skb_flow_dissect(NULL, skb, &flow_keys_dissector, &keys,
+				skb->data, proto, offset, skb_headlen(skb),
+				FLOW_DISSECTOR_F_STOP_BEFORE_ENCAP) ||
+	    keys.control.flags & (FLOW_DIS_IS_FRAGMENT | FLOW_DIS_ENCAPSULATION))
+		return false;
+
+	switch (type) {
+	case PPE_PKT_TYPE_IPV4_HNAPT:
+	case PPE_PKT_TYPE_IPV4_ROUTE:
+		if (keys.control.addr_type != FLOW_DISSECTOR_KEY_IPV4_ADDRS ||
+		    hwe->ipv4.orig_tuple.src_ip != ntohl(keys.addrs.v4addrs.src) ||
+		    hwe->ipv4.orig_tuple.dest_ip != ntohl(keys.addrs.v4addrs.dst))
+			return false;
+		ports = type == PPE_PKT_TYPE_IPV4_HNAPT;
+		if (!ports)
+			return hwe->ipv4.orig_tuple.protocol == keys.basic.ip_proto;
+		if (hwe->ipv4.orig_tuple.src_port != ntohs(keys.ports.src) ||
+		    hwe->ipv4.orig_tuple.dest_port != ntohs(keys.ports.dst))
+			return false;
+		break;
+	case PPE_PKT_TYPE_IPV6_ROUTE_3T:
+	case PPE_PKT_TYPE_IPV6_ROUTE_5T:
+		if (keys.control.addr_type != FLOW_DISSECTOR_KEY_IPV6_ADDRS)
+			return false;
+		for (i = 0; i < ARRAY_SIZE(hwe->ipv6.src_ip); i++)
+			if (hwe->ipv6.src_ip[i] !=
+			    ntohl(keys.addrs.v6addrs.src.s6_addr32[i]) ||
+			    hwe->ipv6.dest_ip[i] !=
+			    ntohl(keys.addrs.v6addrs.dst.s6_addr32[i]))
+				return false;
+		ports = type == PPE_PKT_TYPE_IPV6_ROUTE_5T;
+		if (!ports)
+			return hwe->ipv6.protocol == keys.basic.ip_proto;
+		if (hwe->ipv6.src_port != ntohs(keys.ports.src) ||
+		    hwe->ipv6.dest_port != ntohs(keys.ports.dst))
+			return false;
+		break;
+	default:
+		/* Encapsulated hardware formats require their own full match. */
+		return false;
+	}
+
+	if (keys.basic.ip_proto != IPPROTO_TCP &&
+	    keys.basic.ip_proto != IPPROTO_UDP)
+		return false;
+	/* The dissector can return zero ports for a truncated transport header. */
+	if (!skb_header_pointer(skb, keys.control.thoff, sizeof(ports_buffer),
+				&ports_buffer))
+		return false;
+	return !!(hwe->ib1 & AIROHA_FOE_IB1_BIND_UDP) ==
+	       (keys.basic.ip_proto == IPPROTO_UDP);
+}
