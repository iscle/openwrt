/dts-v1/;

/* Bootloader installs ATF here (BL31 resident region, ~256 KiB). */
/memreserve/ 0x80000000 0x88000;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "an7563.dtsi"

/ {
	model = "Xiaomi BE5000";
	compatible = "xiaomi,be5000", "airoha,an7563", "airoha,en7581";

	aliases {
		led-boot = &led_status_orange;
		led-failsafe = &led_status_orange;
		led-running = &led_status_blue;
		led-upgrade = &led_status_orange;
		serial0 = &uart1;
	};

	chosen {
		bootargs = "console=ttyS0,115200 earlycon";
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x20000000>;
	};

	pwm-leds {
		compatible = "pwm-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&status_led_pins>;

		led_status_blue: led-0 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			pwms = <&an7563_pwm 1 4000000 0>;
			max-brightness = <255>;
			active-low;
		};

		led_status_orange: led-1 {
			color = <LED_COLOR_ID_ORANGE>;
			function = LED_FUNCTION_STATUS;
			pwms = <&an7563_pwm 4 4000000 0>;
			max-brightness = <255>;
			active-low;
			default-state = "on";
		};
	};
};

&an7563_pinctrl {
	gpio-ranges = <&an7563_pinctrl 0 0 28>;

	status_led_pins: status-led-pins {
		function = "pwm";
		pins = "gpio1", "gpio4";
		output-enable;
	};

	wifi-enable-hog {
		/* Stock BL2 drives GPIO 6 high from its embedded environment. */
		gpio-hog;
		gpios = <6 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "wifi-enable";
	};
};

&an7563_pwm {
	status = "okay";
};

&pcie0 {
	compatible = "airoha,an7563-pcie";
	ranges = <0x82000000 0 0x20000000 0x20000000 0 0x4000000>;
	status = "okay";

	pcie@0,0 {
		device_type = "pci";
		reg = <0x0000 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		wifi@0,0 {
			compatible = "mediatek,mt7992";
			reg = <0x0000 0 0 0 0>;
			nvmem-cells = <&wifi_eeprom>;
			nvmem-cell-names = "eeprom";
		};
	};
};

&pcie1 {
	compatible = "airoha,an7563-pcie";
	ranges = <0x82000000 0 0x24000000 0x24000000 0 0x4000000>;
	status = "okay";
};

&snfi {
	status = "okay";
};

&eth {
	status = "okay";
};

&gdm1 {
	status = "okay";
};

&i2c0 {
	status = "okay";
};

&spi_nand {
	airoha,bmt;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "u-boot";
			reg = <0x0 0x7c000>;
			read-only;
		};

		partition@7c000 {
			label = "u-boot-env";
			reg = <0x7c000 0x4000>;
		};

		partition@80000 {
			label = "art";
			reg = <0x80000 0x40000>;
			read-only;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				wifi_eeprom: eeprom@20000 {
					reg = <0x20000 0x1e00>;
				};
			};
		};

		partition@c0000 {
			compatible = "denx,fit";
			label = "firmware";
			reg = <0xc0000 0x4000000>;
		};
	};
};

&hsgmii_pcs {
	status = "okay";
};

&mdio {
	status = "okay";

	phy_2p5g: ethernet-phy@f {
		compatible = "ethernet-phy-id03a2.a411";
		reg = <15>;
		reset-gpios = <&an7563_pinctrl 13 GPIO_ACTIVE_LOW>;
		reset-assert-us = <1000000>;
		reset-deassert-us = <100000>;
	};
};

&gdm2 {
	status = "okay";
	phy-handle = <&phy_2p5g>;
};
