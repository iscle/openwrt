From: Iscle <albertiscle9@gmail.com>
Subject: [PATCH] bridger: wait for command acknowledgments and propagate errors

A filter query can return its data before the acknowledgment. Keep
receiving until the ACK arrives so the next command does not consume a
stale response. Propagate kernel errors instead of treating a rejected
rule as installed, allowing the DSA conduit fallback to run.

Allocate the callback before sending, propagate send failures without
waiting for an impossible ACK, and mark FDB refresh successful only after
the command succeeds. Use libnl error strings for libnl return values.

Signed-off-by: Iscle <albertiscle9@gmail.com>
---
diff --git a/nl.c b/nl.c
index 906bb04..0fca6f3 100644
--- a/nl.c
+++ b/nl.c
@@ -29,6 +29,43 @@ static bool has_flow_offload;
 static bool ignore_errors;
 static bool recv_idle;
 
+static int
+bridger_nl_ack_cb(struct nl_msg *msg, void *arg)
+{
+	bool *done = arg;
+
+	*done = true;
+	return NL_STOP;
+}
+
+static int
+bridger_nl_request(struct nl_msg *msg)
+{
+	struct nl_cb *cb;
+	bool done = false;
+	int ret;
+
+	if (!msg)
+		return -NLE_NOMEM;
+	cb = nl_cb_clone(nl_socket_get_cb(cmd_sock));
+	if (!cb) {
+		nlmsg_free(msg);
+		return -NLE_NOMEM;
+	}
+	nl_cb_set(cb, NL_CB_ACK, NL_CB_CUSTOM, bridger_nl_ack_cb, &done);
+	ret = nl_send_auto_complete(cmd_sock, msg);
+	nlmsg_free(msg);
+	if (ret < 0)
+		goto out;
+	ret = 0;
+	while (!done && !ret)
+		ret = nl_recvmsgs(cmd_sock, cb);
+out:
+	nl_cb_put(cb);
+
+	return ret;
+}
+
 static int offload_handle_cmp(const void *k1, const void *k2, void *ptr)
 {
 	uint32_t v1 = (uint32_t)(uintptr_t)k1;
@@ -543,10 +580,8 @@ bridger_nl_del_filter(struct device *dev, unsigned int prio, bool ingress)
 
 	msg = nlmsg_alloc_simple(RTM_DELTFILTER, NLM_F_REQUEST);
 	nlmsg_append(msg, &tcmsg, sizeof(tcmsg), NLMSG_ALIGNTO);
-	nl_send_auto_complete(cmd_sock, msg);
-	nlmsg_free(msg);
 	ignore_errors = true;
-	nl_wait_for_ack(cmd_sock);
+	bridger_nl_request(msg);
 	ignore_errors = false;
 }
 
@@ -592,10 +627,8 @@ bridger_nl_device_prepare(struct device *dev)
 	msg = nlmsg_alloc_simple(RTM_NEWQDISC, NLM_F_CREATE | NLM_F_EXCL);
 	nlmsg_append(msg, &tcmsg, sizeof(tcmsg), NLMSG_ALIGNTO);
 	nla_put_string(msg, TCA_KIND, "clsact");
-	nl_send_auto_complete(cmd_sock, msg);
-	nlmsg_free(msg);
 	ignore_errors = true;
-	nl_wait_for_ack(cmd_sock);
+	bridger_nl_request(msg);
 	ignore_errors = false;
 }
 
@@ -745,10 +778,7 @@ __bridger_nl_flow_offload_add(struct bridger_flow *flow, struct device *dev)
 
 	nla_nest_end(msg, opts);
 
-	nl_send_auto_complete(cmd_sock, msg);
-	nlmsg_free(msg);
-
-	return nl_wait_for_ack(cmd_sock);
+	return bridger_nl_request(msg);
 }
 
 int bridger_nl_flow_offload_add(struct bridger_flow *flow)
@@ -766,7 +796,7 @@ int bridger_nl_flow_offload_add(struct bridger_flow *flow)
 	for (dev = flow->fdb_in->dev; dev; dev = dev->offload_dev) {
 		ifindex = device_ifindex(dev);
 		ret = __bridger_nl_flow_offload_add(flow, dev);
-		D("Add flow on %s: %s\n", dev->ifname, ret ? strerror(-ret) : "Success");
+		D("Add flow on %s: %s\n", dev->ifname, ret ? nl_geterror(ret) : "Success");
 		if (!ret)
 			break;
 	}
@@ -801,9 +831,7 @@ void bridger_nl_flow_offload_update(struct bridger_flow *flow)
 
 	dev->offload_update = false;
 	msg = bridger_nl_flow_offload_msg(flow, flow->offload_ifindex, RTM_GETTFILTER);
-	nl_send_auto_complete(cmd_sock, msg);
-	nlmsg_free(msg);
-	nl_wait_for_ack(cmd_sock);
+	bridger_nl_request(msg);
 }
 
 void bridger_nl_flow_offload_del(struct bridger_flow *flow)
@@ -821,11 +849,8 @@ void bridger_nl_flow_offload_del(struct bridger_flow *flow)
 	avl_delete(&offload_flows, &flow->offload_node);
 	flow->offload_ifindex = 0;
 	msg = bridger_nl_flow_offload_msg(flow, ifindex, RTM_DELTFILTER);
-	nl_send_auto_complete(cmd_sock, msg);
-	nlmsg_free(msg);
-
 	ignore_errors = true;
-	nl_wait_for_ack(cmd_sock);
+	bridger_nl_request(msg);
 	ignore_errors = false;
 
 	flow->offload_packets = 0;
@@ -873,12 +898,9 @@ int bridger_nl_fdb_refresh(struct fdb_entry *f)
 	if (f->key.vlan)
 		nla_put_u16(msg, NDA_VLAN, f->key.vlan);
 	nla_put(msg, NDA_LLADDR, ETH_ALEN, f->key.addr);
-	nl_send_auto_complete(cmd_sock, msg);
-	nlmsg_free(msg);
-
-	f->updated = true;
-
-	ret = nl_wait_for_ack(cmd_sock);
+	ret = bridger_nl_request(msg);
+	if (!ret)
+		f->updated = true;
 	if (ret)
 		D("Failed to refresh fdb entry %s vid=%d @%s ret=%d\n",
 		  format_macaddr(f->key.addr), f->key.vlan, f->dev->ifname, ret);
@@ -898,10 +920,10 @@ bridge_nl_error_cb(struct sockaddr_nl *nla, struct nlmsgerr *err,
 	const char *errstr = "(unknown)";
 
 	if (ignore_errors)
-		return NL_SKIP;
+		return NL_STOP;
 
 	if (!(nlh->nlmsg_flags & NLM_F_ACK_TLVS))
-		return NL_SKIP;
+		return NL_STOP;
 
 	if (!(nlh->nlmsg_flags & NLM_F_CAPPED))
 		ack_len += err->msg.nlmsg_len - sizeof(*nlh);
@@ -915,7 +937,7 @@ bridge_nl_error_cb(struct sockaddr_nl *nla, struct nlmsgerr *err,
 
 	D("Netlink error(%d): %s\n", err->error, errstr);
 
-	return NL_SKIP;
+	return NL_STOP;
 }
 
 struct nl_sock *
