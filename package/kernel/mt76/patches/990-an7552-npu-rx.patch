 		goto free_skb;
 
 	t = mt76_get_txwi(dev);
@@ -738,7 +780,7 @@
 	if (ret < 0)
 		goto unmap;
 
-	if (mt76_npu_device_active(dev))
+	if (mt76_npu_tx_active(dev))
 		return mt76_npu_dma_add_buf(phy, q, skb, &tx_info.buf[1], txwi);
 
 	return mt76_dma_add_buf(dev, q, tx_info.buf, tx_info.nbuf,
@@ -850,8 +892,16 @@
 	else
 		size = sizeof(struct mt76_desc);
 
-	q->desc = dmam_alloc_coherent(dev->dma_dev, q->ndesc * size,
-				      &q->desc_dma, GFP_KERNEL);
+	if (mt76_queue_is_npu_rx(q) && dev->mmio.npu_rx_only)
+		q->desc = mt76_npu_alloc_rx_desc(dev, q, q->ndesc * size);
+	else
+		q->desc = mt76_dma_alloc_coherent(dev, q->ndesc * size,
+						&q->desc_dma, GFP_KERNEL);
+	if (IS_ERR(q->desc)) {
+		ret = PTR_ERR(q->desc);
+		q->desc = NULL;
+		return ret;
+	}
 	if (!q->desc)
 		return -ENOMEM;
 
