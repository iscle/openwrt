From: Iscle <albertiscle9@gmail.com>
Subject: [PATCH] mt76: mt7996: stop receive polling before DMA cleanup

Disable receive NAPI before freeing DMA page pools. This prevents polling
from accessing released queue buffers during initialization failure.

Signed-off-by: Iscle <albertiscle9@gmail.com>
---
--- a/mt7996/init.c
+++ b/mt7996/init.c
@@ -1827,6 +1827,8 @@
 
 void mt7996_unregister_device(struct mt7996_dev *dev)
 {
+	int i;
+
 	cancel_work_sync(&dev->dump_work);
 	cancel_work_sync(&dev->wed_rro.work);
 	cancel_work_sync(&dev->reset_work);
@@ -1839,11 +1841,18 @@
 	mt7996_wed_rro_free(dev);
 	mt7996_mcu_exit(dev);
 	mt7996_tx_token_put(dev);
+	/* Stop RX polling before deleting NAPI and destroying its page pools. */
+	clear_bit(MT76_STATE_INITIALIZED, &dev->mphy.state);
+	mt7996_irq_disable(dev, ~0);
+	tasklet_disable(&dev->mt76.irq_tasklet);
+	mt76_for_each_q_rx(&dev->mt76, i) {
+		if (dev->mt76.napi[i].poll_list.next)
+			napi_disable(&dev->mt76.napi[i]);
+	}
 	mt7996_dma_cleanup(dev);
 	if (mt7996_has_hwrro(dev) &&
 	    !mtk_wed_device_active(&dev->mt76.mmio.wed))
 		mt7996_rro_msdu_page_map_free(dev);
-	tasklet_disable(&dev->mt76.irq_tasklet);
 
 	mt76_free_device(&dev->mt76);
 }
