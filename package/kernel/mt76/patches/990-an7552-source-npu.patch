+/* Prepare replay snapshots before any link loses its old key state. */
+static int mt7996_npu_prepare_key(struct mt7996_dev *dev,
+				  struct ieee80211_sta *sta, unsigned int link_id,
+				  enum set_key_cmd cmd,
+				  struct ieee80211_key_conf *key)
+{
+	struct mt7996_sta *msta = (void *)sta->drv_priv;
+	struct mt7996_sta_link *msta_link;
+	struct mt7996_npu_key *npu_key;
+	int err;
+
+	msta_link = mt7996_sta_link_protected(dev, msta, link_id);
+	if (!msta_link)
+		return -ENOENT;
+	if (cmd == DISABLE_KEY) {
+		npu_key = msta->npu_key[link_id];
+		if (npu_key) {
+			npu_key->disabled = true;
+			if (!npu_key->saved && mt76_npu_cipher_supported(key->cipher)) {
+				npu_key->error = an7552_npu_pn_get(dev->mt76.mmio.an7552,
+					msta_link->wcid.idx, key->keyidx,
+					&npu_key->pn[0][0]);
+				npu_key->saved = true;
+			}
+		}
+		return 0;
+	}
+	/* Preserve nonce identity for every hardware cipher, including TKIP
+	 * and SMS4 which have no native NPU replay domain.
+	 */
+	{
+		if (key->keylen > sizeof(npu_key->key))
+			return -EINVAL;
+		npu_key = msta->npu_key[link_id];
+		if (!npu_key) {
+			npu_key = kzalloc(sizeof(*npu_key), GFP_KERNEL);
+			if (!npu_key)
+				return -ENOMEM;
+			msta->npu_key[link_id] = npu_key;
+		} else if (npu_key->cipher == key->cipher &&
+			   npu_key->keylen == key->keylen &&
+			   !memcmp(npu_key->key, key->key,
+				   key->keylen)) {
+			/* A removed key no longer has a trustworthy hardware TX PN.
+			 * Require a fresh association secret, even after RX reset.
+			 */
+			if (npu_key->disabled || npu_key->keyidx != key->keyidx)
+				return -EKEYREJECTED;
+			if (!npu_key->saved && mt76_npu_cipher_supported(key->cipher)) {
+				err = an7552_npu_pn_get(dev->mt76.mmio.an7552,
+							msta_link->wcid.idx, key->keyidx,
+							&npu_key->pn[0][0]);
+				npu_key->error = err;
+				npu_key->saved = true;
+			}
+			if (npu_key->error)
+				return npu_key->error;
+		} else {
+			npu_key->saved = false;
+			npu_key->disabled = false;
+			npu_key->error = 0;
+		}
+		memzero_explicit(npu_key->key, sizeof(npu_key->key));
+		memcpy(npu_key->key, key->key, key->keylen);
+		npu_key->cipher = key->cipher;
+		npu_key->keylen = key->keylen;
+		npu_key->keyidx = key->keyidx;
+	}
+	return 0;
+}
