Subject: [PATCH] wifi: mt76: support AN7552 source NPU offload

Connect MT7992 data queues, receive reordering and station lifecycle
to the AN7552 firmware, and preserve encryption counters on recovery.

---
--- a/dma.c
+++ b/dma.c
@@ -7,6 +7,48 @@
 #include "mt76.h"
 #include "dma.h"
 #include "mt76_connac.h"
+
+struct mt76_dma_allocation {
+	struct device *dma_dev;
+	void *addr;
+	dma_addr_t dma_addr;
+	size_t size;
+};
+
+static void mt76_dma_release_coherent(void *data)
+{
+	struct mt76_dma_allocation *allocation = data;
+
+	dma_free_coherent(allocation->dma_dev, allocation->size,
+			  allocation->addr, allocation->dma_addr);
+	put_device(allocation->dma_dev);
+}
+
+void *mt76_dma_alloc_coherent(struct mt76_dev *dev, size_t size,
+			     dma_addr_t *dma_addr, gfp_t gfp)
+{
+	struct mt76_dma_allocation *allocation;
+
+	if (dev->dma_dev == dev->dev)
+		return dmam_alloc_coherent(dev->dma_dev, size, dma_addr, gfp);
+
+	/* The NPU supplies DMA addressing, but the Wi-Fi device owns the memory. */
+	allocation = devm_kzalloc(dev->dev, sizeof(*allocation), gfp);
+	if (!allocation)
+		return NULL;
+	allocation->addr = dma_alloc_coherent(dev->dma_dev, size, dma_addr, gfp);
+	if (!allocation->addr)
+		return NULL;
+	allocation->dma_dev = get_device(dev->dma_dev);
+	allocation->dma_addr = *dma_addr;
+	allocation->size = size;
+	if (devm_add_action_or_reset(dev->dev, mt76_dma_release_coherent,
+				    allocation))
+		return NULL;
+
+	return allocation->addr;
+}
+EXPORT_SYMBOL_GPL(mt76_dma_alloc_coherent);
 
