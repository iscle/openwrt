+void mt76_npu_stop(struct mt76_dev *dev)
+{
+	struct airoha_npu *npu;
+	int i;
+
+	mutex_lock(&dev->mutex);
+	npu = rcu_dereference_protected(dev->mmio.npu,
+					lockdep_is_held(&dev->mutex));
+	if (npu) {
+		for (i = 0; i < 2; i++)
+			airoha_npu_wlan_disable_irq(npu, i);
+		for (i = 0; i < 2; i++)
+			synchronize_irq(npu->irqs[i]);
+	}
+	mutex_unlock(&dev->mutex);
+}
+EXPORT_SYMBOL_GPL(mt76_npu_stop);
+
 void mt76_npu_deinit(struct mt76_dev *dev)
 {
 	struct airoha_ppe_dev *ppe_dev;
 	struct airoha_npu *npu;
+
+	if (dev->mmio.an7552) {
+		an7552_npu_put(dev->mmio.an7552);
+		dev->mmio.an7552 = NULL;
+		ppe_dev = rcu_replace_pointer(dev->mmio.ppe_dev, NULL, true);
+		synchronize_rcu();
+		if (ppe_dev)
+			airoha_ppe_put_dev(ppe_dev);
+		return;
+	}
+	mt76_npu_stop(dev);
 
 	mutex_lock(&dev->mutex);
 
 	npu = rcu_replace_pointer(dev->mmio.npu, NULL,
 				  lockdep_is_held(&dev->mutex));
+	synchronize_rcu();
 	if (npu)
 		airoha_npu_put(npu);
 
