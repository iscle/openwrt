 void mt76_npu_deinit(struct mt76_dev *dev)
 {
 	struct airoha_ppe_dev *ppe_dev;
 	struct airoha_npu *npu;
+
+	if (dev->mmio.an7552) {
+		an7552_npu_put(dev->mmio.an7552);
+		dev->mmio.an7552 = NULL;
+		ppe_dev = rcu_replace_pointer(dev->mmio.ppe_dev, NULL, true);
+		synchronize_rcu();
+		if (ppe_dev)
+			airoha_ppe_put_dev(ppe_dev);
+		return;
+	}
+	mt76_npu_stop(dev);
 
 	mutex_lock(&dev->mutex);
 
 	npu = rcu_replace_pointer(dev->mmio.npu, NULL,
 				  lockdep_is_held(&dev->mutex));
+	synchronize_rcu();
 	if (npu)
 		airoha_npu_put(npu);
 
