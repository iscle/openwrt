+/* RX descriptors identify a WCID and key index, never a key generation.
+ * A used WCID may only acquire a different key after a complete DMA reset.
+ */
+static bool mt7996_npu_same_key(struct ieee80211_key_conf *a,
+                               struct ieee80211_key_conf *b)
+{
+	return a && a->keyidx == b->keyidx && a->cipher == b->cipher &&
+	       a->keylen == b->keylen && !memcmp(a->key, b->key, a->keylen);
+}
+
+static int mt7996_npu_key_gate(struct mt7996_dev *dev,
+			      struct mt7996_sta_link *sl,
+			      enum set_key_cmd cmd,
+			      struct ieee80211_key_conf *key)
+{
+	if (cmd != SET_KEY)
+		return 0;
+	if (!test_bit(sl->wcid.idx, dev->npu_key_used))
+		return 0;
+	if (!test_bit(sl->wcid.idx, dev->npu_rx_retired) &&
+	    sl->wcid.hw_key_idx == key->keyidx &&
+	    mt7996_npu_same_key(sl->data_key, key))
+		return 0;
+
+	set_bit(sl->wcid.idx, dev->npu_rx_retired);
+	/* A firmware-only forwarding pause cannot drain already decrypted RX.
+	 * Stop every native writer, then request the full radio/DMA flush.
+	 */
+	an7552_npu_stop(dev->mt76.mmio.an7552);
+	dev->recovery.restart = true;
+	queue_work(dev->mt76.wq, &dev->reset_work);
+	return -EKEYREJECTED;
+}
