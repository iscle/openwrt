+			if (link && mt7996_mcu_set_qos_map(dev, link->mt76.idx,
+							   mvif->npu_qos_map))
+				an7552_npu_qos_map(dev->mt76.mmio.an7552, link->mt76.idx, NULL);
+		}
+	}
+	mutex_unlock(&dev->mt76.mutex);
+	return ret;
+}
