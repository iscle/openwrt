+static int mt7996_npu_build_qos_map(u8 *map, struct cfg80211_qos_map *qos)
+{
+	struct sk_buff *skb;
+	struct iphdr *ip;
+	unsigned int i;
+
+	/* Use cfg80211's classifier, including custom ranges and exceptions,
+	 * instead of maintaining a second interpretation of its DSCP policy.
+	 */
+	skb = alloc_skb(sizeof(*ip), GFP_KERNEL);
+	if (!skb)
+		return -ENOMEM;
+	ip = skb_put_zero(skb, sizeof(*ip));
+	skb_reset_network_header(skb);
+	skb->protocol = htons(ETH_P_IP);
+	ip->version = 4;
+	ip->ihl = 5;
+	for (i = 0; i < 64; i++) {
+		ip->tos = i << 2;
+		map[i] = cfg80211_classify8021d(skb, qos);
+	}
+	kfree_skb(skb);
+	return 0;
+}
