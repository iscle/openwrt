+static void mt7996_sync_key_pn(struct ieee80211_hw *hw,
+			      struct ieee80211_vif *vif,
+			      struct ieee80211_sta *sta,
+			      struct ieee80211_key_conf *key, void *data)
+{
+	struct mt7996_dev *dev = data;
+	struct mt7996_sta *msta = sta ? (void *)sta->drv_priv : NULL;
+	unsigned long links;
+	unsigned int id;
+	u64 saved = atomic64_read(&key->tx_pn);
+
+	switch (key->cipher) {
+	case WLAN_CIPHER_SUITE_TKIP:
+	case WLAN_CIPHER_SUITE_CCMP:
+	case WLAN_CIPHER_SUITE_CCMP_256:
+	case WLAN_CIPHER_SUITE_GCMP:
+	case WLAN_CIPHER_SUITE_GCMP_256:
+		break;
+	default:
+		return;
+	}
+
+	if (key->link_id >= 0)
+		links = BIT(key->link_id);
+	else if (sta && sta->valid_links)
+		links = sta->valid_links;
+	else
+		links = BIT(0);
+
+	for_each_set_bit(id, &links, IEEE80211_MLD_MAX_NUM_LINKS) {
+		struct mt7996_vif_link *link = mt7996_vif_link(dev, vif, id);
+		struct mt7996_sta_link *sl;
+		struct mt76_wcid *wcid;
+		u32 selector, low, high;
+		u64 pn;
+
+		if (!link)
+			continue;
+		sl = msta ? mt7996_sta_link(msta, id) : &link->msta_link;
+		if (!sl)
+			continue;
+		wcid = &sl->wcid;
+		if (wcid->hw_key_idx != key->keyidx)
+			continue;
+
+		selector = mt76_rr(dev, MT_UWTBL_WDUCR);
+		mt76_wr(dev, MT_UWTBL_WDUCR, wcid->idx >> 7);
+		low = mt76_rr(dev, MT_UWTBL_PN_LOW(wcid->idx));
+		high = mt76_rr(dev, MT_UWTBL_PN_HIGH(wcid->idx));
+		mt76_wr(dev, MT_UWTBL_WDUCR, selector);
+		pn = (u64)(high & 0xffff) << 32 | low;
+		saved = max(saved, pn);
+		dev_dbg(dev->mt76.dev, "TX replay snapshot WCID %u PN %llu\n",
+			 wcid->idx, pn);
+	}
+
+	atomic64_set(&key->tx_pn, saved);
+}
+
+int mt7996_mac_set_key_pn(struct mt7996_dev *dev, struct mt76_wcid *wcid, u64 pn)
+{
+	u32 selector, high, low;
+	u64 restored;
+
+	lockdep_assert_held(&dev->mt76.mutex);
+	selector = mt76_rr(dev, MT_UWTBL_WDUCR);
+	mt76_wr(dev, MT_UWTBL_WDUCR, wcid->idx >> 7);
+	high = mt76_rr(dev, MT_UWTBL_PN_HIGH(wcid->idx));
+	mt76_wr(dev, MT_UWTBL_PN_LOW(wcid->idx), lower_32_bits(pn));
+	mt76_wr(dev, MT_UWTBL_PN_HIGH(wcid->idx),
+		(high & 0xffff0000) | upper_32_bits(pn));
+	low = mt76_rr(dev, MT_UWTBL_PN_LOW(wcid->idx));
+	high = mt76_rr(dev, MT_UWTBL_PN_HIGH(wcid->idx));
+	mt76_wr(dev, MT_UWTBL_WDUCR, selector);
+	restored = (u64)(high & 0xffff) << 32 | low;
+	dev_dbg(dev->mt76.dev, "TX replay restored WCID %u PN %llu readback %llu\n",
+		 wcid->idx, pn, restored);
+
+	return restored >= pn ? 0 : -EIO;
+}
+
+void mt7996_mac_save_key_pn(struct mt7996_dev *dev)
+{
+	struct mt7996_phy *phy;
+
+	if (!is_mt7992(&dev->mt76))
+		return;
+
+	/* Stop MAC encryption before reading the hardware-owned packet numbers. */
+	mt7996_for_each_phy(dev, phy)
+		mt76_set(dev, MT_ARB_SCR(phy->mt76->band_idx),
+			 MT_ARB_SCR_TX_DISABLE);
+	udelay(1);
+	rcu_read_lock();
+	ieee80211_iter_keys_rcu(mt76_hw(dev), NULL, mt7996_sync_key_pn, dev);
+	rcu_read_unlock();
+}
