+static int mt7996_npu_commit_key(struct mt7996_dev *dev,
+				 struct ieee80211_sta *sta, unsigned long changed,
+				 struct ieee80211_key_conf *key)
+{
+	struct mt7996_sta *msta = (void *)sta->drv_priv;
+	u16 wcids[IEEE80211_MLD_MAX_NUM_LINKS];
+	unsigned int id, count = 0;
+
+	if (!changed || !mt76_npu_cipher_supported(key->cipher))
+		return 0;
+	for_each_set_bit(id, &changed, IEEE80211_MLD_MAX_NUM_LINKS) {
+		struct mt7996_sta_link *link;
+
+		link = mt7996_sta_link_protected(dev, msta, id);
+		if (!link || link->data_key != key)
+			return -ENOENT;
+		wcids[count++] = link->wcid.idx;
+	}
+	return an7552_npu_pn_commit(dev->mt76.mmio.an7552, wcids,
+				    count, key->keyidx);
+}
