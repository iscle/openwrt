+static void mt7996_npu_save_pn_iter(void *data, struct ieee80211_sta *sta)
+{
+	struct mt7996_sta *msta = (void *)sta->drv_priv;
+	struct mt7996_dev *dev = data;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(msta->npu_key); i++) {
+		struct mt7996_sta_link *link = mt7996_sta_link(msta, i);
+		struct mt7996_npu_key *key = msta->npu_key[i];
+
+		if (!link || !key || key->saved ||
+		    !mt76_npu_cipher_supported(key->cipher))
+			continue;
+		key->error = an7552_npu_pn_get(dev->mt76.mmio.an7552,
+					       link->wcid.idx, key->keyidx,
+					       &key->pn[0][0]);
+		key->saved = true;
+		dev_dbg(dev->mt76.dev, "NPU replay snapshot WCID %u status %d\n",
+			link->wcid.idx, key->error);
+	}
+}
