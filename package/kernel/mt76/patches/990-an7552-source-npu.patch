+/* Prepare replay snapshots before any link loses its old key state. */
+static int mt7996_npu_prepare_key(struct mt7996_dev *dev,
+				  struct ieee80211_sta *sta, unsigned int link_id,
+				  enum set_key_cmd cmd,
+				  struct ieee80211_key_conf *key)
+{
+	struct mt7996_sta *msta = (void *)sta->drv_priv;
+	struct mt7996_sta_link *msta_link;
+	struct mt7996_npu_key *npu_key;
+	int err;
+
+	msta_link = mt7996_sta_link_protected(dev, msta, link_id);
+	if (!msta_link)
+		return -ENOENT;
+	if (cmd == DISABLE_KEY || !mt76_npu_cipher_supported(key->cipher)) {
+		kfree_sensitive(msta->npu_key[link_id]);
+		msta->npu_key[link_id] = NULL;
+	} else {
+		if (key->keylen > sizeof(npu_key->key))
+			return -EINVAL;
+		npu_key = msta->npu_key[link_id];
+		if (!npu_key) {
+			npu_key = kzalloc(sizeof(*npu_key), GFP_KERNEL);
+			if (!npu_key)
+				return -ENOMEM;
+			msta->npu_key[link_id] = npu_key;
+		} else if (npu_key->keyidx == key->keyidx &&
+			   npu_key->cipher == key->cipher &&
+			   npu_key->keylen == key->keylen &&
+			   !memcmp(npu_key->key, key->key,
+				   key->keylen)) {
+			if (!npu_key->saved) {
+				err = an7552_npu_pn_get(dev->mt76.mmio.an7552,
+							msta_link->wcid.idx, key->keyidx,
+							&npu_key->pn[0][0]);
+				npu_key->error = err;
+				npu_key->saved = true;
+			}
+			if (npu_key->error)
+				return npu_key->error;
+		} else {
+			npu_key->saved = false;
+			npu_key->error = 0;
+		}
+		memzero_explicit(npu_key->key, sizeof(npu_key->key));
+		memcpy(npu_key->key, key->key, key->keylen);
+		npu_key->cipher = key->cipher;
+		npu_key->keylen = key->keylen;
+		npu_key->keyidx = key->keyidx;
+	}
+	return 0;
+}
+
+static int mt7996_npu_key_links(struct mt7996_dev *dev,
+				struct ieee80211_vif *vif,
+				struct ieee80211_sta *sta, unsigned long links,
+				struct ieee80211_key_conf *key, bool enable)
+{
+	struct mt7996_sta *msta = (void *)sta->drv_priv;
+	unsigned int id;
+	int err = 0;
+
+	for_each_set_bit(id, &links, IEEE80211_MLD_MAX_NUM_LINKS) {
+		struct mt7996_sta_link *sl;
+		struct mt7996_vif_link *vl;
+		int ret;
+
+		sl = mt7996_sta_link_protected(dev, msta, id);
+		if (!sl)
+			continue;
+		if (enable) {
+			if (!sl->npu_authorized)
+				continue;
+			vl = mt7996_vif_link(dev, vif, id);
+			if (!vl || !link_sta_dereference_protected(sta, id)) {
+				err = -ENOENT;
+				break;
+			}
+			ret = an7552_npu_station_set(dev->mt76.mmio.an7552,
+						     sl->wcid.idx, vl->mt76.band_idx,
+						     vl->mt76.idx, sta->addr, true,
+						     sta->mlo,
+						     mt76_npu_cipher_supported(key->cipher));
+		} else {
+			ret = an7552_npu_station_set(dev->mt76.mmio.an7552,
+						     sl->wcid.idx, sl->wcid.phy_idx,
+						     0, NULL, false, false, false);
+		}
+		if (ret && !err)
+			err = ret;
+		/* Revocation must visit every link even if a handshake fails. */
+		if (ret && enable)
+			break;
+	}
+	return err;
+}
