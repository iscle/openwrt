+/* Only a peer's identical installed key may share its replay domain. */
+static u32 mt7996_npu_key_domain(struct mt7996_dev *dev,
+				 struct ieee80211_sta *sta, unsigned int link_id,
+				struct ieee80211_key_conf *key)
+{
+	struct mt7996_sta *msta;
+	unsigned int id;
+
+	if (!sta || !dev->mt76.mmio.an7552 ||
+	    !(key->flags & IEEE80211_KEY_FLAG_PAIRWISE))
+		return 0;
+	msta = (void *)sta->drv_priv;
+	for (id = 0; id < IEEE80211_MLD_MAX_NUM_LINKS; id++) {
+		struct mt7996_sta_link *link;
+		struct ieee80211_key_conf *installed;
+		u32 domain;
+
+		if (id == link_id)
+			continue;
+		link = mt7996_sta_link_protected(dev, msta, id);
+		if (!link || !link->wcid.sta)
+			continue;
+		installed = link->data_key;
+		if (!installed || installed->cipher != key->cipher ||
+		    installed->keyidx != key->keyidx ||
+		    installed->keylen != key->keylen ||
+		    memcmp(installed->key, key->key, key->keylen))
+			continue;
+		domain = an7552_npu_pn_domain(dev->mt76.mmio.an7552,
+					      link->wcid.idx, key->keyidx);
+		if (domain)
+			return domain;
+	}
+	return 0;
+}
