+void mt76_npu_flush_station(struct mt76_dev *dev, u16 wcid, u8 band)
+{
+	struct airoha_ppe_dev *ppe;
+
+	/* The caller has revoked npu_authorized. Finish receive callbacks that
+	 * observed its old value before flushing and releasing this WCID.
+	 * Full radio recovery stops NAPI separately and does not call here.
+	 */
+	synchronize_net();
+	rcu_read_lock();
+	ppe = rcu_dereference(dev->mmio.ppe_dev);
+	if (ppe)
+		airoha_ppe_dev_flush_wdma(ppe, wcid, band);
+	rcu_read_unlock();
+}
+EXPORT_SYMBOL_GPL(mt76_npu_flush_station);
 
