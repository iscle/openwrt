+static int mt7996_set_qos_map(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
+			      struct cfg80211_qos_map *qos)
+{
+	struct mt7996_dev *dev = mt7996_hw_dev(hw);
+	struct mt7996_vif *mvif = (void *)vif->drv_priv;
+	unsigned long links = vif->valid_links ?: BIT(0);
+	unsigned int id;
+	u8 map[64];
+	int ret;
+
+	if (!dev->mt76.mmio.an7552)
+		return 0;
+	ret = mt7996_npu_build_qos_map(map, qos);
+	if (ret)
+		return ret;
+	mutex_lock(&dev->mt76.mutex);
+	for_each_set_bit(id, &links, IEEE80211_MLD_MAX_NUM_LINKS) {
+		struct mt7996_vif_link *link = mt7996_vif_link(dev, vif, id);
+
+		if (!link)
+			continue;
+		ret = mt7996_mcu_set_qos_map(dev, link->mt76.idx, map);
+		if (ret)
+			break;
+	}
+	if (!ret) {
+		memcpy(mvif->npu_qos_map, map, sizeof(map));
+	} else {
+		/* Roll back a map which only some radios accepted. If rollback
+		 * fails, leave that BSS ineligible for accelerated steering.
+		 */
+		for_each_set_bit(id, &links, IEEE80211_MLD_MAX_NUM_LINKS) {
+			struct mt7996_vif_link *link = mt7996_vif_link(dev, vif, id);
