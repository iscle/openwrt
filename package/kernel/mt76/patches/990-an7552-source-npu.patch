+static inline int native_rx_band(struct mt76_queue *q)
+{
+	if (!q->dev || !an7552_npu_active(q->dev->mmio.an7552) ||
+	    q->dev->hwrro_mode != MT76_HWRRO_V3_1)
+		return -1;
+	if (q == &q->dev->q_rx[MT_RXQ_RRO_BAND0])
+		return 0;
+	if (q == &q->dev->q_rx[MT_RXQ_RRO_BAND1])
+		return 1;
+	return -1;
+}
+
+static inline int native_txfree_band(struct mt76_queue *q)
+{
+	struct mt76_dev *dev = q->dev;
+
+	if (!dev || mt76_chip(dev) != 0x7992 || !an7552_npu_active(q->dev->mmio.an7552))
+		return -1;
+	if (q == &dev->q_rx[MT_RXQ_MAIN_WA])
+		return 0;
+	if (q == &dev->q_rx[MT_RXQ_BAND1_WA])
+		return 1;
+	return -1;
+}
